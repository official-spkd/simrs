{
  "name": "simrs",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @simrs/db migrate",
    "db:deploy": "pnpm --filter @simrs/db deploy:migrations",
    "db:seed": "pnpm --filter @simrs/db seed",
    "db:studio": "pnpm --filter @simrs/db studio",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "~6.0.2"
  }
}
