{
  "name": "simrs",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:lokal": "node scripts/with-pg.mjs pnpm exec turbo run dev --parallel --filter=@simrs/api --filter=@simrs/web --filter=@simrs/worker --filter=@simrs/mock",
    "dev:demo": "node scripts/dev-demo.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @simrs/db migrate",
    "db:deploy": "pnpm --filter @simrs/db deploy:migrations",
    "db:seed": "pnpm --filter @simrs/db seed",
    "db:create-admin": "pnpm --filter @simrs/db create-admin",
    "db:create-demo": "pnpm --filter @simrs/db create-demo",
    "db:akun-presentasi": "pnpm --filter @simrs/db akun-presentasi",
    "db:import-ref": "pnpm --filter @simrs/db import-ref",
    "db:studio": "pnpm --filter @simrs/db studio",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "doctor": "node scripts/doctor.mjs",
    "infra:up": "docker compose up -d",
    "infra:ps": "docker compose ps",
    "pg:portable": "node scripts/pg-portable.mjs",
    "db:test:recreate": "node scripts/recreate-test-db.mjs",
    "with-pg": "node scripts/with-pg.mjs",
    "env:init": "node scripts/init-env.mjs"
  },
  "devDependencies": {
    "@types/node": "^24",
    "embedded-postgres": "16.14.0-beta.17",
    "pg": "^8.23.1",
    "prettier": "^3",
    "turbo": "^2",
    "typescript": "~6.0.2"
  }
}
