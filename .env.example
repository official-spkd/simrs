# ===== SIM RS · lingkungan lokal (data fiktif) =====
NODE_ENV=development
TZ=Asia/Jakarta
# Lingkungan deploy: local | demo | staging | production. Tidak disetel = production (gagal aman):
# Swagger, endpoint /api/v1/dev, tenant dari header, dan panduan superadmin tanpa login MATI.
# demo = demo publik ber-data fiktif (HTTPS): pengamanan setara staging, mode presentasi (DATA_SOURCE=demo) boleh,
# INTEGRATION_MODE wajib mock, STORAGE_DRIVER=disk boleh.
APP_ENV=local
# Alamat bind API dan mock (loopback = tidak terbuka ke jaringan)
HOST=127.0.0.1

# Postgres (lihat infra/postgres/init.sql)
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=postgres_local
DATABASE_URL=postgresql://simrs_app:app_local@localhost:5432/simrs?schema=public
MIGRATOR_DATABASE_URL=postgresql://simrs_migrator:migrator_local@localhost:5432/simrs?schema=public
TEST_DATABASE_URL=postgresql://simrs_migrator:migrator_local@localhost:5432/simrs_test?schema=public
TEST_APP_DATABASE_URL=postgresql://simrs_app:app_local@localhost:5432/simrs_test?schema=public

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO (S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-3
S3_ACCESS_KEY=simrs_local
S3_SECRET_KEY=simrs_local_secret
S3_BUCKET_DOCUMENTS=simrs-documents
S3_BUCKET_BACKUPS=simrs-backups
# Konsol MinIO. Ubah bila port 9001 sudah dipakai (mis. Laravel Herd di Windows).
MINIO_CONSOLE_PORT=9001
# Penyimpanan berkas dokumen (P08, ADR-0020): s3 = MinIO di atas (bucket S3_BUCKET_DOCUMENTS), wajib di staging
# dan produksi (kredensial khusus aplikasi, bukan root). disk = folder lokal (relatif terhadap apps/<app>), hanya
# diterima bila APP_ENV=local (mis. tanpa Docker).
STORAGE_DRIVER=disk
STORAGE_DISK_ROOT=../../.local/storage

# Email lokal (Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="SIM RS Lokal <no-reply@simrs.local>"

# Aplikasi
API_PORT=4000
WEB_PORT=3000
MOCK_PORT=4100
# API hanya mendengar di HOST (127.0.0.1); alamat IPv4 eksplisit agar localhost:4000 milik aplikasi lain di IPv6
# tidak terpakai. WEB_BASE_URL tetap localhost (dipatok tes CORS API).
API_BASE_URL=http://127.0.0.1:4000
WEB_BASE_URL=http://localhost:3000
MOCK_BASE_URL=http://localhost:4100
# Prefiks path web bila dipasang di bawah path, bukan akar domain (mis. demo publik demo.spkd.store/demo-simrs →
# /demo-simrs). Dibakukan saat build web: ubah lalu `pnpm build` ulang. Kosong = akar domain.
WEB_BASE_PATH=
# Isi awal kolom "Kode RS" di layar masuk (lokal/staging; produksi memakai subdomain). Kosong di lokal = RSCM.
LOGIN_TENANT_CODE=RSCM
# Sumber data layar fase 2–10 yang backend-nya belum ada (ADR-0023): api | demo. `demo` = mode presentasi dengan
# data dummy fiktif, hanya berlaku bila APP_ENV=local. Untuk presentasi cukup `pnpm dev:demo` (tanpa mengubah ini).
DATA_SOURCE=api
# Peta refresh sesi web (ADR-0073): auto | redis | memory. auto = Redis dari REDIS_URL bila terjangkau, selain itu
# memori proses dengan peringatan. Banyak instans web wajib Redis (memory diabaikan di produksi).
REFRESH_STORE=auto
# Awalan kunci Redis peta refresh. Kosong = simrs:web:refresh:
REFRESH_REDIS_PREFIX=
# Web multi-instans: kunci enkripsi Server Action yang SAMA di semua instans (build + runtime), 32 byte base64.
# Bangkitkan: openssl rand -base64 32. Kosong di lokal (satu instans; Next membangkitkan kunci sendiri per build).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Sesi login (ADR-0011): token buram berotasi, bukan JWT
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_TTL_HOURS=8
# Cache matriks izin per RS × peran (detik). Perubahan di layar Akses berlaku seketika (invalidasi + Redis
# pub/sub antar-instans); TTL = batas keusangan bila siaran terlewat. Redis putus → baca DB. 0 = cache mati.
AUTHZ_CACHE_TTL_SECONDS=30
# Batas permintaan per menit per endpoint: per IP (umum), per IP khusus endpoint kredensial (login/MFA/ganti
# sandi/refresh), dan per pengguna login (apa pun IP-nya; staf satu RS sering berbagi IP lewat NAT)
RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT_PER_MIN=10
USER_RATE_LIMIT_PER_MIN=300
# Gateway informasi publik F08 (jadwal, antrean berjalan) per IP per endpoint.
PUBLIC_RATE_LIMIT_PER_MIN=60
# Status booking publik: tanggal lahir salah per kode booking (apa pun IP-nya) sebelum kode itu dijawab 404 seragam
# sampai jendela (menit, sejak salah pertama) habis.
BOOKING_STATUS_MAX_FAILURES=10
BOOKING_STATUS_FAILURE_WINDOW_MINUTES=1440
# Penyimpanan penghitung batas laju: auto | redis | memory. auto = Redis bila terjangkau saat start, selain itu
# memori proses (hanya di luar produksi). Produksi wajib Redis (memory ditolak); bila Redis gagal, endpoint
# kredensial ditolak 503 (gagal tertutup) dan batas lain sementara per instans.
RATE_LIMIT_STORE=auto
# Awalan kunci Redis. Kosong = simrs:rl:<nama database>: (instans satu deployment berbagi penghitung).
RATE_LIMIT_REDIS_PREFIX=
# Mode pengembang tanpa login: tenant dari header X-Tenant-Id. Hanya berlaku bila APP_ENV=local.
ALLOW_DEV_TENANT_HEADER=true
# Proxy tepercaya di depan API (web BFF, reverse proxy) untuk X-Forwarded-For/-Host. Wajib di produksi,
# berisi alamat/CIDR server web dan reverse proxy. true/* ditolak (klien bisa memalsukan IP).
TRUST_PROXY=loopback
# Kunci enkripsi kolom identitas (32 byte base64). Bangkitkan: openssl rand -base64 32
# FIELD_*_KEY = kunci v1 (format lama). Rotasi kunci (docs/panduan/05-rotasi-kunci.md): cincin
# FIELD_*_KEYS=v2:<base64>,v1:<base64> — kunci PERTAMA aktif untuk tulisan baru, sisanya hanya untuk membaca data
# lama. Bila cincin memuat v1, nilainya wajib sama dengan FIELD_*_KEY (atau kosongkan FIELD_*_KEY).
FIELD_ENCRYPTION_KEY=
FIELD_HASH_KEY=
FIELD_ENCRYPTION_KEYS=
FIELD_HASH_KEYS=
# Job enkripsi ulang di worker: off (bawaan; jalankan pnpm db:rotate-keys --run) | auto (putaran berkala selama
# cincin masih memuat kunci lama). Batch per transaksi, jeda antar-batch (ms), selang putaran (menit).
FIELD_KEY_ROTATION=off
FIELD_KEY_ROTATION_BATCH=200
FIELD_KEY_ROTATION_PAUSE_MS=100
FIELD_KEY_ROTATION_INTERVAL_MINUTES=60
# Jangkar hash audit (P04, ADR-0072): kunci HMAC TERPISAH (32 byte base64, harus beda dari semua kunci kolom di atas),
# dipakai worker (menandatangani tiap jam) dan API (memeriksa di /audit/verify). Wajib di produksi; kosong di lokal =
# jangkar tidak ditulis dan pemeriksaan selalu penuh. Bangkitkan: openssl rand -base64 32
AUDIT_ANCHOR_KEY=
# Bucket WORM jangkar (S3 Object Lock, mode COMPLIANCE): buat sekali dengan `mc mb --with-lock` (docker compose
# membuat simrs-audit-anchors). Wajib di produksi; kosong = jangkar hanya di database. Masa kunci objek (hari):
# objek tidak bisa dihapus siapa pun sebelum masa ini habis, jadi lokal cukup 1 hari.
AUDIT_ANCHOR_BUCKET=
AUDIT_ANCHOR_RETENTION_DAYS=1

# Mode integrasi: mock | sandbox | production (lokal selalu mock)
INTEGRATION_MODE=mock

# BPJS (mock) — nilai fiktif
BPJS_BASE_URL=http://localhost:4100/bpjs
BPJS_CONS_ID=10000
BPJS_SECRET_KEY=mock-secret
BPJS_USER_KEY=mock-user-key
BPJS_PPK_CODE=0301R001

# E-Klaim (mock)
EKLAIM_BASE_URL=http://localhost:4100/eklaim
EKLAIM_ENCRYPTION_KEY=mock-eklaim-key

# SATUSEHAT (mock)
SATUSEHAT_AUTH_URL=http://localhost:4100/satusehat/oauth2/v1
SATUSEHAT_BASE_URL=http://localhost:4100/satusehat/fhir-r4/v1
SATUSEHAT_CLIENT_ID=mock-client
SATUSEHAT_CLIENT_SECRET=mock-secret
SATUSEHAT_ORGANIZATION_ID=mock-org-001

# Dukcapil & TTE (mock)
DUKCAPIL_BASE_URL=http://localhost:4100/dukcapil
TTE_BASE_URL=http://localhost:4100/tte

# TPDI (mock) — agregator teknologi pembayaran
TPDI_BASE_URL=http://localhost:4100/tpdi/v1
TPDI_MERCHANT_ID=TPDI-RS-00127
TPDI_API_KEY=mock-tpdi-key
TPDI_WEBHOOK_SECRET=mock-tpdi-webhook-secret
TPDI_WEBHOOK_TARGET=http://127.0.0.1:4000/api/v1/webhooks/tpdi

# Analyzer laboratorium (mock, fase 4 §4.1b) — mock mengirim ORU^R01 ke endpoint perangkat SIM RS. Token = token
# prinsipal perangkat analyzer (dv1…, daftarkan di Sistem › Perangkat); kunci HMAC perangkat lokal saja.
LIS_HL7_TARGET=http://127.0.0.1:4000/api/v1/devices/lis/hl7
LIS_DEVICE_TOKEN=mock-lis-device-token
LIS_DEVICE_SECRET=mock-lis-device-secret

# BTN (mock) — rekening, mutasi, pembiayaan
BTN_BASE_URL=http://localhost:4100/btn/v1
BTN_CLIENT_ID=mock-btn
BTN_CLIENT_SECRET=mock-btn-secret
BTN_ACCOUNT_OPERATIONAL=0000000004417
BTN_ACCOUNT_CLAIM_ESCROW=0000000009021

# Backup terenkripsi tiga lokasi (ADR-0071, docs/panduan/04-backup-restore.md). Hanya untuk host/kontainer ops,
# bukan aplikasi. Peran simrs_backup (baca semua data + BYPASSRLS) dibuat init.sql; port ikut POSTGRES_PORT.
BACKUP_DATABASE_URL=postgresql://simrs_backup:backup_local@localhost:5432/simrs
# Kunci PUBLIK penerima (simrsbk1:…), dari `pnpm backup:kunci-baru --keluar <folder offline>`. Kunci privat TIDAK
# pernah di host backup; hanya di mesin uji restore lewat BACKUP_PRIVATE_KEY_FILE (+ frasa sandi bila ada).
BACKUP_PUBLIC_KEY=
BACKUP_PRIVATE_KEY_FILE=
# Lokasi 1 = BACKUP_LOCAL_DIR, 2 = bucket S3_BUCKET_BACKUPS, 3 = bucket offsite (produksi: penyedia/region lain,
# isi BACKUP_OFFSITE_S3_ENDPOINT/_ACCESS_KEY/_SECRET_KEY).
BACKUP_LOCAL_DIR=.local/backup
BACKUP_PREFIX=simrs/
BACKUP_OFFSITE_BUCKET=simrs-backups-offsite
# Lokal saja: buat bucket bila belum ada. Kredensial produksi tidak boleh punya hak membuat bucket.
BACKUP_ENSURE_BUCKETS=true
# Retensi per lokasi: per jam, harian, bulanan (harian terbaru tiap bulan), manual
BACKUP_KEEP_HOURLY=48
BACKUP_KEEP_DAILY=35
BACKUP_KEEP_MONTHLY=12
BACKUP_KEEP_MANUAL=10
