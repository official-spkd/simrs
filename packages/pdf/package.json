{
  "name": "@simrs/pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ibm/plex-mono": "1.1.0",
    "@ibm/plex-sans": "1.1.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@simrs/shared": "workspace:*",
    "pdf-lib": "1.17.1",
    "uqr": "0.1.3",
    "zod": "^4"
  },
  "devDependencies": {
    "@simrs/config": "workspace:*",
    "eslint": "^10",
    "tsup": "^8.5.1",
    "vitest": "^5"
  }
}
