// Skema SIM RS. Konvensi: docs/04-data-model.md §1.
// - PK UUID v7 dibangkitkan aplikasi; tabel domain punya tenant_id + RLS (lihat migrasi, ADR-0002, ADR-0008).
// - Nama tabel/kolom snake_case jamak; model Prisma PascalCase.
// - Kebijakan RLS, GRANT, trigger, dan fungsi ditulis manual di migration.sql (Prisma tidak memodelkannya).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// P01 · Tenant = satu RS, atau satu tenant khusus operator platform (kind = platform, ADR-0013).
/// RLS: baris hanya terlihat oleh tenant itu sendiri.
model Tenant {
  id             String   @id @db.Uuid
  code           String   @unique
  name           String
  kemenkesCode   String?  @map("kemenkes_code")
  bpjsPpkCode    String?  @map("bpjs_ppk_code")
  satusehatOrgId String?  @map("satusehat_org_id")
  hospitalClass  String?  @map("hospital_class")
  status         String   @default("active")
  /// hospital | platform (hanya satu tenant platform; indeks unik parsial di migrasi).
  kind           String   @default("hospital")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  outboxMessages        OutboxMessage[]
  deliveryAttempts      DeliveryAttempt[]
  inboundEvents         InboundEvent[]
  auditEvents           AuditEvent[]
  facilities            Facility[]
  units                 Unit[]
  locations             Location[]
  modules               TenantModule[]
  settings              TenantSetting[]
  numberSequences       NumberSequence[]
  domains               TenantDomain[]
  users                 User[]
  credentials           UserCredential[]
  mfaFactors            MfaFactor[]
  sessions              AuthSession[]
  loginChallenges       LoginChallenge[]
  roles                 Role[]
  rolePermissions       RolePermission[]
  assignments           StaffAssignment[]
  relationships         AccessRelationship[]
  breakGlassGrants      BreakGlassGrant[]
  notifications         Notification[]
  patients              Patient[]
  identifiers           PatientIdentifier[]
  matchCandidates       PatientMatchCandidate[]
  patientLinks          PatientLink[]
  privacyConsents       PrivacyConsent[]
  formDefinitions       FormDefinition[]
  formResponses         FormResponse[]
  documents             Document[]
  signatures            DocumentSignature[]
  trustedDevices        TrustedDevice[]
  devices               RegisteredDevice[]
  // Fase 2 · front office
  practitioners         Practitioner[]
  externalIds           ExternalId[]
  payers                Payer[]
  queueServices         QueueService[]
  queueDisplays         QueueDisplay[]
  queueDisplayServices  QueueDisplayService[]
  practitionerSchedules PractitionerSchedule[]
  scheduleSessions      ScheduleSession[]
  hfisScheduleSnapshots HfisScheduleSnapshot[]
  appointments          Appointment[]
  queueTickets          QueueTicket[]
  queueCalls            QueueCall[]
  bpjsQueueTasks        BpjsQueueTask[]
  encounters            Encounter[]
  encounterStatuses     EncounterStatusHistory[]
  coverages             Coverage[]
  referrals             Referral[]
  seps                  Sep[]
  patientContacts       PatientContact[]

  @@map("tenants")
}

/// I01 · Transactional outbox (ADR-0003). Ditulis dalam transaksi domain; dikirim worker.
model OutboxMessage {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  target         String
  operation      String
  idempotencyKey String    @map("idempotency_key")
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  deadAt         DateTime? @map("dead_at") @db.Timestamptz(3)
  /// Dikirim ulang manual (dari DLQ): batas retry hari layanan dihitung dari `coalesce(requeued_at, created_at)`.
  requeuedAt     DateTime? @map("requeued_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  deliveries DeliveryAttempt[]

  @@unique([tenantId, target, idempotencyKey])
  @@index([tenantId, status, nextAttemptAt])
  @@map("outbox_messages")
}

/// Jejak setiap percobaan kirim (request/response tersamar, durasi, kode).
model DeliveryAttempt {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  outboxMessageId String   @map("outbox_message_id") @db.Uuid
  attemptNo       Int      @map("attempt_no")
  startedAt       DateTime @map("started_at") @db.Timestamptz(3)
  durationMs      Int      @map("duration_ms")
  statusCode      Int?     @map("status_code")
  outcome         String
  error           String?
  responseExcerpt String?  @map("response_excerpt")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  outboxMessage OutboxMessage @relation(fields: [outboxMessageId], references: [id])

  @@index([tenantId, outboxMessageId])
  @@map("delivery_attempts")
}

/// Webhook masuk mentah (TPDI, BTN). Unik per sumber + idempotency key; diproses async.
model InboundEvent {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  source         String
  idempotencyKey String    @map("idempotency_key")
  headers        Json
  rawBody        String    @map("raw_body")
  status         String    @default("received")
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  error          String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, source, idempotencyKey])
  @@map("inbound_events")
}

/// P04 · Audit trail append-only dengan hash berantai per tenant. seq, prev_hash, hash, dan occurred_at
/// diisi trigger database (app_audit_chain), bukan aplikasi. UPDATE/DELETE ditolak.
model AuditEvent {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Nomor urut per tenant (1, 2, 3, …); celah = baris hilang.
  seq          BigInt   @default(0)
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorRole    String?  @map("actor_role")
  patientId    String?  @map("patient_id") @db.Uuid
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  action       String
  /// success | denied
  outcome      String   @default("success")
  reason       String?
  ip           String?
  userAgent    String?  @map("user_agent")
  requestId    String?  @map("request_id")
  /// Metadata tanpa PHI (mis. nama field yang berubah, jumlah hasil pencarian).
  details      Json?
  prevHash     String?  @map("prev_hash")
  hash         String   @default("")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, seq])
  @@index([tenantId, occurredAt])
  @@index([tenantId, patientId, occurredAt])
  @@index([tenantId, actorUserId, occurredAt])
  @@map("audit_events")
}

/// P01 · Faskes/cabang milik tenant (RS). Master: tidak dihapus, dinonaktifkan (active = false).
model Facility {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  code         String
  name         String
  kemenkesCode String?  @map("kemenkes_code")
  address      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String?  @map("created_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy    String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  units  Unit[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("facilities")
}

/// P01 · Unit layanan (instalasi, poli, IGD, bangsal, penunjang, farmasi, OK, administrasi).
model Unit {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  facilityId String   @map("facility_id") @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  code       String
  name       String
  kind       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?  @map("created_by") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?  @map("updated_by") @db.Uuid

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  /// FK komposit: unit hanya bisa menunjuk faskes milik tenant yang sama (FK tidak tunduk RLS).
  facility      Facility          @relation(fields: [tenantId, facilityId], references: [tenantId, id])
  parent        Unit?             @relation("UnitTree", fields: [tenantId, parentId], references: [tenantId, id])
  children      Unit[]            @relation("UnitTree")
  locations     Location[]
  assignments   StaffAssignment[]
  queueServices QueueService[]
  encounters    Encounter[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, facilityId])
  @@map("units")
}

/// P01 · Lokasi fisik: ruang → kamar → bed. Kelas perawatan dipakai Aplicare/BPJS dan tarif.
model Location {
  id                  String   @id @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  unitId              String   @map("unit_id") @db.Uuid
  parentId            String?  @map("parent_id") @db.Uuid
  kind                String
  code                String
  name                String
  careClass           String?  @map("care_class")
  satusehatLocationId String?  @map("satusehat_location_id")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy           String?  @map("created_by") @db.Uuid
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy           String?  @map("updated_by") @db.Uuid

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  unit     Unit       @relation(fields: [tenantId, unitId], references: [tenantId, id])
  parent   Location?  @relation("LocationTree", fields: [tenantId, parentId], references: [tenantId, id])
  children Location[] @relation("LocationTree")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, unitId])
  @@map("locations")
}

/// P10 · Modul aktif per RS (feature flag). Tidak ada baris = bawaan katalog (MVP aktif).
model TenantModule {
  tenantId   String   @map("tenant_id") @db.Uuid
  moduleCode String   @map("module_code")
  enabled    Boolean
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, moduleCode])
  @@map("tenant_modules")
}

/// P12 · Pengaturan per RS. Kunci dan bentuk nilai divalidasi registri di @simrs/shared (kunci asing ditolak).
model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("tenant_settings")
}

/// P08 · Penomoran dokumen per tenant × jenis × periode. Nilai hanya naik; nomor tidak pernah dipakai ulang.
model NumberSequence {
  tenantId  String   @map("tenant_id") @db.Uuid
  kind      String
  /// '' untuk nomor tanpa periode (No. RM), 'YYMM' untuk dokumen bulanan.
  period    String
  lastValue BigInt   @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, kind, period])
  @@map("number_sequences")
}

/// P02 · Pemetaan host (subdomain) → tenant untuk login produksi. Registri platform: aplikasi tidak punya GRANT,
/// hanya fungsi app_resolve_tenant_by_host() yang membacanya.
model TenantDomain {
  host      String   @id
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_domains")
}

/// P02 · Akun per orang (tanpa akun bersama). Tidak dihapus; dinonaktifkan (status = disabled).
model User {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  /// NIP atau email RS, selalu huruf kecil (CHECK di database).
  username           String
  displayName        String    @map("display_name")
  email              String?
  /// No. HP staf terenkripsi (`staff_phone`, bentuk baku 62…): WhatsApp notifikasi + kode cadangan login.
  phoneEnc           String?   @map("phone_enc")
  /// active | disabled
  status             String    @default("active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy          String?   @map("updated_by") @db.Uuid

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  credential          UserCredential?
  mfaFactors          MfaFactor[]
  sessions            AuthSession[]
  loginChallenges     LoginChallenge[]
  assignments         StaffAssignment[]
  accessRelationships AccessRelationship[]
  breakGlassGrants    BreakGlassGrant[]    @relation("BreakGlassUser")
  breakGlassReviews   BreakGlassGrant[]    @relation("BreakGlassReviewer")
  notifications       Notification[]
  signatures          DocumentSignature[]
  trustedDevices      TrustedDevice[]
  devices             RegisteredDevice[]   @relation("RegisteredDeviceUser")
  devicesRevoked      RegisteredDevice[]   @relation("RegisteredDeviceRevoker")
  practitioners       Practitioner[]

  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@map("users")
}

/// P02 · Hash kata sandi (argon2id) dipisah dari users agar tidak ikut terbaca query pengguna biasa.
model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@unique([tenantId, userId])
  @@map("user_credentials")
}

/// P02 · Faktor MFA. Rahasia TOTP terenkripsi (AES-256-GCM, kunci per tenant). last_used_step mencegah replay.
model MfaFactor {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  kind         String    @default("totp")
  secretEnc    String    @map("secret_enc")
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(3)
  lastUsedStep Int?      @map("last_used_step")
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@index([tenantId, userId])
  @@map("mfa_factors")
}

/// P02 · Sesi login. Token buram (bukan JWT): yang disimpan hanya hash SHA-256; dicek di setiap permintaan
/// sehingga logout/pencabutan berlaku seketika. Refresh token berotasi; pemakaian ulang token lama → sesi dicabut.
model AuthSession {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  accessHash          String    @map("access_hash")
  accessExpiresAt     DateTime  @map("access_expires_at") @db.Timestamptz(3)
  refreshHash         String    @map("refresh_hash")
  previousRefreshHash String?   @map("previous_refresh_hash")
  refreshExpiresAt    DateTime  @map("refresh_expires_at") @db.Timestamptz(3)
  lastSeenAt          DateTime  @map("last_seen_at") @db.Timestamptz(3)
  idleTimeoutMinutes  Int       @map("idle_timeout_minutes")
  mfaVerified         Boolean   @default(false) @map("mfa_verified")
  unitId              String?   @map("unit_id") @db.Uuid
  /// P03 · Penugasan aktif yang dipilih (menentukan peran dan unit sesi).
  assignmentId        String?   @map("assignment_id") @db.Uuid
  /// P02 · Perangkat terdaftar yang membuka sesi ini dengan PIN (ADR-0024): posisi terkunci ke posisi pendaftaran
  /// PIN, sesi pendek, dan sesi ikut berakhir saat PIN perangkat itu dicabut.
  deviceId            String?   @map("device_id") @db.Uuid
  /// active | revoked
  status              String    @default("active")
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason       String?   @map("revoked_reason")
  ip                  String?
  userAgent           String?   @map("user_agent")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  user       User              @relation(fields: [tenantId, userId], references: [tenantId, id])
  assignment StaffAssignment?  @relation(fields: [tenantId, assignmentId], references: [tenantId, id])
  device     RegisteredDevice? @relation(fields: [tenantId, deviceId], references: [tenantId, id])

  @@index([tenantId, userId, status])
  @@index([tenantId, deviceId])
  @@map("auth_sessions")
}

/// P02 · Tantangan MFA setelah kata sandi benar (berlaku 5 menit, maksimal 5 percobaan, sekali pakai).
model LoginChallenge {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  secretHash String    @map("secret_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Kode cadangan 6 digit (WhatsApp/email) terenkripsi `login_otp`; berlaku selama tantangan, berbagi batas
  /// percobaan dengan TOTP.
  otpEnc     String?   @map("otp_enc")
  /// whatsapp | email
  otpChannel String?   @map("otp_channel")
  otpSentAt  DateTime? @map("otp_sent_at") @db.Timestamptz(3)
  otpSends   Int       @default(0) @map("otp_sends")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@map("login_challenges")
}

/// P03 · Peran per RS. Peran sistem (16 bawaan) dibuat otomatis; matriks izinnya bisa diubah per RS.
model Role {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  isSystem  Boolean  @default(true) @map("is_system")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  assignments StaffAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("roles")
}

/// P03 · Izin peran: sumber × aksi × lingkup (all | unit | relationship). Katalog sah di @simrs/shared.
model RolePermission {
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  resource  String
  action    String
  scope     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id])

  @@id([roleId, resource, action])
  @@index([tenantId, roleId])
  @@map("role_permissions")
}

/// P03 · Penugasan staf: pengguna × peran × unit × periode. Tidak dihapus; diakhiri dengan valid_until.
model StaffAssignment {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  unitId     String?   @map("unit_id") @db.Uuid
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)
  endReason  String?   @map("end_reason")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?   @map("updated_by") @db.Uuid

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  user     User               @relation(fields: [tenantId, userId], references: [tenantId, id])
  role     Role               @relation(fields: [tenantId, roleId], references: [tenantId, id])
  unit     Unit?              @relation(fields: [tenantId, unitId], references: [tenantId, id])
  sessions AuthSession[]
  devices  RegisteredDevice[]

  @@unique([tenantId, id])
  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@map("staff_assignments")
}

/// P03 · Relasi klinisi–pasien untuk ABAC (DPJP, perawat penanggung jawab, rawat bersama, konsultan).
/// Diisi modul klinis (fase 2–3) dari encounter; FK ke patients ditambahkan saat tabel pasien dibuat (P05).
model AccessRelationship {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  patientId  String    @map("patient_id") @db.Uuid
  kind       String
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)
  sourceType String?   @map("source_type")
  sourceId   String?   @map("source_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  user    User    @relation(fields: [tenantId, userId], references: [tenantId, id])
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@index([tenantId, userId, patientId])
  @@index([tenantId, patientId])
  @@map("access_relationships")
}

/// P03 · Akses darurat (break-the-glass): alasan wajib, berbatas waktu, ditinjau petugas privasi.
/// Aplikasi hanya boleh mengubah kolom tinjauan (column privilege); alasan & waktu tidak bisa diubah.
model BreakGlassGrant {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  reason        String
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  reviewOutcome String?   @map("review_outcome")
  reviewNote    String?   @map("review_note")
  reviewedBy    String?   @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(3)

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  user     User    @relation("BreakGlassUser", fields: [tenantId, userId], references: [tenantId, id])
  reviewer User?   @relation("BreakGlassReviewer", fields: [tenantId, reviewedBy], references: [tenantId, id])
  patient  Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@index([tenantId, userId, patientId, expiresAt])
  @@index([tenantId, reviewOutcome])
  @@map("break_glass_grants")
}

/// P11 (awal) · Notifikasi in-app. Tanpa PHI di judul/isi; tautan ke halaman yang menerapkan izin.
model Notification {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  kind            String
  title           String
  body            String
  link            String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  recipient User   @relation(fields: [tenantId, recipientUserId], references: [tenantId, id])

  @@index([tenantId, recipientUserId, readAt])
  @@map("notifications")
}

/// P05 · Master Patient Index. Satu baris = satu rekam medis (nomor RM). Data identitas, bukan entri klinis:
/// boleh diubah (diaudit per nama field), tidak pernah dihapus. Penggabungan = penanda `merged` + rujukan ke
/// rekam medis yang dipertahankan (P05, potongan 7b); nomor RM tidak berubah.
/// NIK dan identifier lain di `patient_identifiers`; alamat dan no. HP dienkripsi di aplikasi (docs/04 §1).
model Patient {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  /// Nomor rekam medis `00-41-27-88` dari layanan penomoran (P08, jenis `mrn`). Tidak bisa diubah (hak kolom).
  mrn                String
  name               String
  /// Nama ternormalisasi untuk trigram/duplikat (`normalizePersonName`), indeks GIN di migrasi.
  nameSearch         String    @map("name_search")
  /// male | female | unknown (kode FHIR gender)
  sex                String
  birthDate          DateTime? @map("birth_date") @db.Date
  birthDateEstimated Boolean   @default(false) @map("birth_date_estimated")
  motherName         String?   @map("mother_name")
  /// AES-256-GCM (`encryptField`, tujuan `contact`).
  addressEnc         String?   @map("address_enc")
  phoneEnc           String?   @map("phone_enc")
  /// Blind index HMAC no. HP baku `62…` untuk pencocokan duplikat.
  phoneHash          String?   @map("phone_hash")
  /// Pasien tanpa identitas (mis. IGD tidak sadar, "Tn. X").
  unidentified       Boolean   @default(false)
  /// active | merged
  status             String    @default("active")
  mergedIntoId       String?   @map("merged_into_id") @db.Uuid
  mergedAt           DateTime? @map("merged_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy          String?   @map("updated_by") @db.Uuid

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  mergedInto      Patient?                @relation("PatientMerge", fields: [tenantId, mergedIntoId], references: [tenantId, id])
  mergedFrom      Patient[]               @relation("PatientMerge")
  identifiers     PatientIdentifier[]
  relationships   AccessRelationship[]
  breakGlass      BreakGlassGrant[]
  matchesAsA      PatientMatchCandidate[] @relation("MatchA")
  matchesAsB      PatientMatchCandidate[] @relation("MatchB")
  linksAsSurvivor PatientLink[]           @relation("LinkSurvivor")
  linksAsMerged   PatientLink[]           @relation("LinkMerged")
  consents        PrivacyConsent[]
  formResponses   FormResponse[]
  documents       Document[]
  appointments    Appointment[]
  queueTickets    QueueTicket[]
  encounters      Encounter[]
  referrals       Referral[]
  contacts        PatientContact[]

  @@unique([tenantId, id])
  @@unique([tenantId, mrn])
  @@index([tenantId, birthDate])
  @@index([tenantId, phoneHash])
  @@index([tenantId, mergedIntoId])
  /// Pencarian nama mirip (pg_trgm; btree_gin untuk tenant_id).
  @@index([tenantId(ops: raw("uuid_ops")), nameSearch(ops: raw("gin_trgm_ops"))], map: "patients_name_search_trgm", type: Gin)
  @@map("patients")
}

/// P05 · Identifier eksternal pasien (NIK, no. BPJS, IHS SATUSEHAT, paspor). Nilai terenkripsi + blind index.
/// Nilai tidak pernah diubah: koreksi = baris baru, baris lama dinonaktifkan dengan alasan (hak kolom).
/// Maksimal satu identifier aktif per sistem per pasien (indeks unik parsial di migrasi).
model PatientIdentifier {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  /// nik | bpjs | ihs | paspor
  system              String
  /// AES-256-GCM (`encryptField`, tujuan `patient_identifier`).
  valueEnc            String    @map("value_enc")
  /// HMAC `sistem:nilai` (`blindIndex`) untuk pencarian sama-persis tanpa menyimpan nilai.
  valueHash           String    @map("value_hash")
  active              Boolean   @default(true)
  /// unverified | pending | verified | mismatch | not_found | error (verifikasi Dukcapil, potongan 7c; error =
  /// pesan outbox gagal permanen)
  verificationStatus  String    @default("unverified") @map("verification_status")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(3)
  /// Hasil verifikasi tanpa PHI (mis. field yang tidak cocok).
  verificationDetails Json?     @map("verification_details")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy           String?   @map("created_by") @db.Uuid
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(3)
  deactivatedBy       String?   @map("deactivated_by") @db.Uuid
  deactivationReason  String?   @map("deactivation_reason")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  patient   Patient    @relation(fields: [tenantId, patientId], references: [tenantId, id])
  coverages Coverage[]

  @@unique([tenantId, id])
  @@index([tenantId, system, valueHash])
  @@index([tenantId, patientId])
  @@map("patient_identifiers")
}

/// P05 · Pasangan kemungkinan rekam medis ganda (antrean layar MPI). A = rekam medis lebih lama (usulan
/// dipertahankan), B = lebih baru (usulan digabungkan). Satu baris per pasangan tak berurutan (indeks unik di
/// migrasi). Alasan berupa kode tanpa PHI. Keputusan petugas tercatat di sini dan di jejak audit.
model PatientMatchCandidate {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  patientAId     String    @map("patient_a_id") @db.Uuid
  patientBId     String    @map("patient_b_id") @db.Uuid
  /// 0–99 (`scorePatientMatch`).
  score          Int
  /// Kode alasan (`MATCH_REASONS`), larik JSON.
  reasons        Json
  /// open | merged | distinct | superseded
  status         String    @default("open")
  detectedAt     DateTime  @default(now()) @map("detected_at") @db.Timestamptz(3)
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedBy      String?   @map("decided_by") @db.Uuid
  decisionReason String?   @map("decision_reason")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  patientA Patient       @relation("MatchA", fields: [tenantId, patientAId], references: [tenantId, id])
  patientB Patient       @relation("MatchB", fields: [tenantId, patientBId], references: [tenantId, id])
  links    PatientLink[]

  @@unique([tenantId, id])
  @@index([tenantId, status, score])
  @@index([tenantId, patientAId])
  @@index([tenantId, patientBId])
  @@map("patient_match_candidates")
}

/// P05 · Jejak penggabungan: rekam medis B (`merged`) digabung ke A (`survivor`). Tidak ada data yang dipindah
/// atau dihapus; pembatalan (≤ 30 hari) hanya mengisi kolom `undone_*` (hak kolom).
model PatientLink {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  survivorId          String    @map("survivor_id") @db.Uuid
  mergedId            String    @map("merged_id") @db.Uuid
  candidateId         String?   @map("candidate_id") @db.Uuid
  reason              String
  /// Nama atribut yang diambil dari B (`MERGE_ATTRIBUTES`), tanpa nilai.
  takenAttributes     Json      @default("[]") @map("taken_attributes")
  /// Nilai A sebelum ditimpa: JSON terenkripsi (tujuan `patient_snapshot`) untuk pemulihan saat dibatalkan.
  survivorSnapshotEnc String?   @map("survivor_snapshot_enc")
  mergedAt            DateTime  @default(now()) @map("merged_at") @db.Timestamptz(3)
  mergedBy            String?   @map("merged_by") @db.Uuid
  undoneAt            DateTime? @map("undone_at") @db.Timestamptz(3)
  undoneBy            String?   @map("undone_by") @db.Uuid
  undoReason          String?   @map("undo_reason")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  survivor  Patient                @relation("LinkSurvivor", fields: [tenantId, survivorId], references: [tenantId, id])
  merged    Patient                @relation("LinkMerged", fields: [tenantId, mergedId], references: [tenantId, id])
  candidate PatientMatchCandidate? @relation(fields: [tenantId, candidateId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, survivorId])
  @@index([tenantId, candidateId])
  @@map("patient_links")
}

/// P05 · Persetujuan privasi pasien (docs/05 §1, UU PDP): persetujuan umum dan pembukaan data ke pihak ketiga.
/// Dicatat atas nama petugas; pencabutan mengisi kolom `revoked_*` (hak kolom), baris tidak pernah dihapus.
model PrivacyConsent {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  patientId          String    @map("patient_id") @db.Uuid
  /// umum | pembukaan_data
  kind               String
  /// Penerima data (wajib untuk pembukaan data), mis. nama asuransi.
  recipient          String?
  note               String?
  givenAt            DateTime  @default(now()) @map("given_at") @db.Timestamptz(3)
  givenBy            String?   @map("given_by") @db.Uuid
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy          String?   @map("revoked_by") @db.Uuid
  revokeReason       String?   @map("revoke_reason")
  /// Fase 2 · persetujuan umum rawat inap berlaku per admisi (encounter); rawat jalan null = sampai dicabut.
  encounterId        String?   @map("encounter_id") @db.Uuid
  /// Bukti tertulis/scan opsional (dokumen P08).
  evidenceDocumentId String?   @map("evidence_document_id") @db.Uuid

  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  patient          Patient    @relation(fields: [tenantId, patientId], references: [tenantId, id])
  encounter        Encounter? @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  evidenceDocument Document?  @relation(fields: [tenantId, evidenceDocumentId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, patientId])
  @@map("privacy_consents")
}

/// P07 · Definisi formulir klinis berversi (formulir = data, MRMIK 6c). Satu versi berlaku (`published`) dan
/// paling banyak satu draf terbuka per kode (indeks unik parsial). Isi versi terbit/arsip tidak bisa diubah
/// (trigger `app_form_definition_guard`): isian lama selalu terbaca dengan versi saat diisi.
model FormDefinition {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  code        String
  version     Int
  title       String
  /// keperawatan | medis | kebidanan | umum
  category    String
  /// draft | submitted | published | archived
  status      String    @default("draft")
  /// Bagian, field, opsi, skor, logika tampil (`formSchemaSchema` di @simrs/shared).
  schema      Json
  /// Kode peran yang boleh mengisi (hak tulis per profesi, MRMIK 10a).
  writeRoles  String[]  @map("write_roles")
  changeNote  String    @map("change_note")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String?   @map("updated_by") @db.Uuid
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)
  submittedBy String?   @map("submitted_by") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  publishedBy String?   @map("published_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  responses FormResponse[]

  @@unique([tenantId, id])
  @@unique([tenantId, code, version])
  @@map("form_definitions")
}

/// P07 · Isian formulir untuk pasien. Append-only (ADR-0004): koreksi = baris baru (`version` + 1,
/// `supersedes_id`, `correction_reason`); tidak ada UPDATE/DELETE (hak + trigger). Kelompok versi = `root_id`.
model FormResponse {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  patientId        String   @map("patient_id") @db.Uuid
  /// Versi definisi yang dipakai saat diisi (bukan selalu versi terbaru).
  definitionId     String   @map("definition_id") @db.Uuid
  formCode         String   @map("form_code")
  version          Int      @default(1)
  /// ID versi 1 (kelompok semua versi isian ini).
  rootId           String   @map("root_id") @db.Uuid
  supersedesId     String?  @map("supersedes_id") @db.Uuid
  /// final | entered_in_error
  status           String   @default("final")
  answers          Json
  score            Int?
  scoreBand        String?  @map("score_band")
  correctionReason String?  @map("correction_reason")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?  @map("created_by") @db.Uuid

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  patient      Patient        @relation(fields: [tenantId, patientId], references: [tenantId, id])
  definition   FormDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id])
  supersedes   FormResponse?  @relation("FormResponseVersion", fields: [tenantId, supersedesId], references: [tenantId, id])
  supersededBy FormResponse[] @relation("FormResponseVersion")

  @@unique([tenantId, id])
  @@unique([tenantId, rootId, version])
  @@index([tenantId, patientId, formCode])
  @@map("form_responses")
}

/// P08 · Dokumen pasien (lampiran foto/scan, hasil, surat). Berkas ada di penyimpanan objek dengan kunci acak
/// (`storage_key`); baris ini hanya metadata + SHA-256 isi berkas. Tidak pernah diubah atau dihapus: salah
/// unggah ditandai batal sekali dengan alasan, dan dokumen bertanda tangan tidak bisa dibatalkan (trigger,
/// ADR-0020).
model Document {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  patientId  String    @map("patient_id") @db.Uuid
  /// lampiran | hasil | surat | resume | consent | lainnya
  kind       String
  title      String
  /// Nama untuk tampilan/unduhan saja (sudah disaring).
  fileName   String    @map("file_name")
  /// Dikenali dari isi berkas: application/pdf | image/png | image/jpeg
  mimeType   String    @map("mime_type")
  sizeBytes  Int       @map("size_bytes")
  sha256     String
  storageKey String    @unique @map("storage_key")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedBy   String?   @map("voided_by") @db.Uuid
  voidReason String?   @map("void_reason")

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  patient    Patient             @relation(fields: [tenantId, patientId], references: [tenantId, id])
  signatures DocumentSignature[]
  /// Bukti persetujuan (scan) yang dirujuk persetujuan privasi.
  consents   PrivacyConsent[]

  @@unique([tenantId, id])
  @@index([tenantId, patientId, createdAt])
  @@map("documents")
}

/// P08 · Tanda tangan elektronik atas hash dokumen, dimintakan ke penyelenggara TTE lewat outbox. Satu
/// penanda tangan sekali per dokumen; hash yang ditandatangani wajib sama dengan hash dokumen, dan setelah
/// `signed` baris terkunci (trigger). `verify_code` dicetak sebagai QR untuk verifikasi publik tanpa PHI.
model DocumentSignature {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  documentId          String    @map("document_id") @db.Uuid
  signerUserId        String    @map("signer_user_id") @db.Uuid
  documentSha256      String    @map("document_sha256")
  /// pending | signed | failed (gagal permanen di penyelenggara TTE; bisa dikirim ulang → pending)
  status              String    @default("pending")
  verifyCode          String    @unique @map("verify_code")
  requestedAt         DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  signedAt            DateTime? @map("signed_at") @db.Timestamptz(3)
  providerSignatureId String?   @map("provider_signature_id")
  certificate         String?
  signature           String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  document Document @relation(fields: [tenantId, documentId], references: [tenantId, id])
  signer   User     @relation(fields: [tenantId, signerUserId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, documentId, signerUserId])
  @@map("document_signatures")
}

/// P02 · "Percayai perangkat ini" (mockup Login): selama berlaku, login dengan sandi di perangkat ini melewati
/// langkah MFA. Token buram di cookie httpOnly; di sini hanya hash-nya. Dicabut saat sandi/MFA direset atau akun
/// dinonaktifkan.
model TrustedDevice {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  /// Ringkas (maks. 200 karakter), untuk ditampilkan/ditinjau.
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, userId])
  @@map("trusted_devices")
}

/// P02 · Perangkat terdaftar (docs/05 §1, ADR-0024). Jenis `staff_pin` = PIN masuk cepat: satu baris = satu akun ×
/// satu perangkat (peramban) × satu posisi berunit, didaftarkan dari login penuh di perangkat itu sendiri. Token buram
/// `sd1` di cookie httpOnly peramban; di sini hanya hash-nya. PIN disimpan argon2id dari HMAC berlada
/// (FIELD_HASH_KEY) yang terikat tenant + akun + perangkat. Fase 2 memakai ulang tabel ini untuk anjungan/TV (jenis
/// baru, kolom khusus PIN kosong). Tidak dihapus: pencabutan = kolom `revoked_*`, final (dijaga trigger).
model RegisteredDevice {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// staff_pin (CHECK database; jenis lain menyusul fase 2)
  kind           String    @default("staff_pin")
  /// staff_pin: pemilik PIN (wajib untuk jenis ini, CHECK `registered_devices_staff_pin`).
  userId         String?   @map("user_id") @db.Uuid
  /// staff_pin: posisi (penugasan) yang dibuka sesi PIN; unitnya = unit tempat perangkat terdaftar.
  assignmentId   String?   @map("assignment_id") @db.Uuid
  /// Nama perangkat dari pengguna (mis. "Komputer nurse station Melati").
  name           String
  tokenHash      String    @unique @map("token_hash")
  /// staff_pin: argon2id dari HMAC berlada atas tenant + perangkat + akun + PIN.
  pinHash        String?   @map("pin_hash")
  /// Percobaan salah berturut-turut, dicadangkan sebelum PIN diperiksa (aman dari tebakan paralel); maks. 5.
  failedAttempts Int       @default(0) @map("failed_attempts")
  /// Ringkas (maks. 200 karakter), untuk ditampilkan/ditinjau.
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// staff_pin: maks. 30 hari setelah didaftarkan (CHECK database).
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// user_removed | admin_revoked | too_many_attempts | password_changed | password_reset | mfa_reset |
  /// user_disabled | assignment_ended
  revokedReason  String?   @map("revoked_reason")
  /// Pengguna yang mencabut (pemilik atau admin); kosong untuk pencabutan sistem (mis. terlalu banyak salah).
  revokedBy      String?   @map("revoked_by") @db.Uuid

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  user       User?            @relation("RegisteredDeviceUser", fields: [tenantId, userId], references: [tenantId, id])
  assignment StaffAssignment? @relation(fields: [tenantId, assignmentId], references: [tenantId, id])
  revoker    User?            @relation("RegisteredDeviceRevoker", fields: [tenantId, revokedBy], references: [tenantId, id])
  sessions   AuthSession[]

  @@unique([tenantId, id])
  @@index([tenantId, userId])
  @@map("registered_devices")
}

// =====================================================================================================================
// Fase 2 · Front office (F01–F07): master praktik + antrean, jadwal dan kuota, booking, antrean + task ID BPJS,
// kunjungan, penjaminan, rujukan, SEP, kontak pasien. Rencana: docs/rencana/fase-2-front-office.md §2 (potongan 0b).
// Semua tabel: tenant_id + RLS FORCE, FK komposit (tenant_id, id), tanpa DELETE. Status/jenis dibatasi CHECK di
// migrasi `20261005101000_front_office` (nilai mengikuti kontrak bersama potongan 0a).
// =====================================================================================================================

/// F01 · Tenaga medis yang berpraktik (DPJP di jadwal, booking, kunjungan, SEP). Bisa tanpa akun SIM RS
/// (`user_id` null), mis. dokter tamu yang belum punya akun.
model Practitioner {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  /// Akun SIM RS bila ada (paling banyak satu praktisi per akun).
  userId        String?   @map("user_id") @db.Uuid
  /// Nama + gelar seperti di jadwal dan SEP.
  name          String
  /// dokter | dokter_gigi | bidan | perawat
  profession    String    @default("dokter")
  /// Spesialisasi untuk tampilan, mis. "Penyakit dalam".
  specialty     String?
  strNumber     String?   @map("str_number")
  sipNumber     String?   @map("sip_number")
  sipValidUntil DateTime? @map("sip_valid_until") @db.Date
  /// IHS Practitioner ID (SATUSEHAT).
  ihsId         String?   @map("ihs_id")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?   @map("created_by") @db.Uuid
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy     String?   @map("updated_by") @db.Uuid

  tenant             Tenant                 @relation(fields: [tenantId], references: [id])
  user               User?                  @relation(fields: [tenantId, userId], references: [tenantId, id])
  schedules          PractitionerSchedule[]
  sessions           ScheduleSession[]      @relation("SessionPractitioner")
  substituteSessions ScheduleSession[]      @relation("SessionSubstitute")
  hfisSnapshots      HfisScheduleSnapshot[]
  appointments       Appointment[]
  encounters         Encounter[]
  referrals          Referral[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@unique([tenantId, ihsId])
  @@map("practitioners")
}

/// ID di sistem luar (docs/04 §1): kode poli BPJS, kode dokter HFIS, ID resource SATUSEHAT, dst. Satu nilai per
/// entitas × sistem; nilai bisa dikoreksi, tidak dihapus (nonaktif).
model ExternalId {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// practitioner | queue_service | unit | location | patient | encounter | sep
  entity    String
  entityId  String   @map("entity_id") @db.Uuid
  /// Sistem penerbit, mis. `bpjs:poli`, `bpjs:hfis-dokter`, `satusehat:location`.
  system    String
  value     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, entity, entityId, system])
  @@index([tenantId, system, value])
  @@map("external_ids")
}

/// F06 · Penjamin: BPJS, umum (pribadi), asuransi, perusahaan.
model Payer {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  /// bpjs | umum | asuransi | perusahaan
  kind      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  coverages Coverage[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("payers")
}

/// F04 · Layanan antrean: poli (PD, JT, …), loket pendaftaran (A), farmasi (F), kasir (K). `code` = awalan nomor.
model QueueService {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// Awalan nomor antrean, 1–2 huruf kapital (`PD-027`, `A-031`).
  code      String
  name      String
  /// poli | loket | farmasi | kasir | penunjang
  kind      String
  unitId    String?  @map("unit_id") @db.Uuid
  room      String?
  floor     Int?     @db.SmallInt
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  unit         Unit?                  @relation(fields: [tenantId, unitId], references: [tenantId, id])
  displays     QueueDisplayService[]
  schedules    PractitionerSchedule[]
  sessions     ScheduleSession[]
  appointments Appointment[]
  tickets      QueueTicket[]
  encounters   Encounter[]
  referrals    Referral[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("queue_services")
}

/// F04 · Papan antrean (TV ruang tunggu), mis. "Rawat Jalan Lantai 2". Perangkat TV menyusul (ADR-0027).
model QueueDisplay {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy String?  @map("created_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant   Tenant                @relation(fields: [tenantId], references: [id])
  services QueueDisplayService[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("queue_displays")
}

/// Layanan yang tampil di satu papan, berurutan. Dilepas dengan `active = false` (tanpa DELETE).
model QueueDisplayService {
  tenantId  String   @map("tenant_id") @db.Uuid
  displayId String   @map("display_id") @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  position  Int      @db.SmallInt
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  display QueueDisplay @relation(fields: [tenantId, displayId], references: [tenantId, id])
  service QueueService @relation(fields: [tenantId, serviceId], references: [tenantId, id])

  @@id([displayId, serviceId])
  @@index([tenantId, displayId])
  @@map("queue_display_services")
}

/// F01 · Templat praktik mingguan (hari ISO, jam, kuota JKN/non-JKN). Sesi per tanggal dibangkitkan darinya.
model PractitionerSchedule {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  practitionerId String    @map("practitioner_id") @db.Uuid
  serviceId      String    @map("service_id") @db.Uuid
  /// 1 = Senin … 7 = Minggu (ISO).
  weekday        Int       @db.SmallInt
  /// Jam dinding WIB.
  startTime      DateTime  @map("start_time") @db.Time(0)
  endTime        DateTime  @map("end_time") @db.Time(0)
  quotaJkn       Int       @map("quota_jkn")
  quotaNonJkn    Int       @map("quota_non_jkn")
  validFrom      DateTime  @map("valid_from") @db.Date
  validUntil     DateTime? @map("valid_until") @db.Date
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  practitioner Practitioner      @relation(fields: [tenantId, practitionerId], references: [tenantId, id])
  service      QueueService      @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  sessions     ScheduleSession[]

  @@unique([tenantId, id])
  @@index([tenantId, practitionerId])
  @@index([tenantId, serviceId, weekday])
  @@map("practitioner_schedules")
}

/// F01 · Sesi praktik satu tanggal dengan kuota. `booked_* <= quota_*` dijamin CHECK; reservasi lewat
/// `reserveQuota` (UPDATE bersyarat atomik). `cuti` + pengganti: pengganti melayani dengan kuota sesi ini.
model ScheduleSession {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// Templat asal (null = sesi tambahan).
  scheduleId     String?   @map("schedule_id") @db.Uuid
  practitionerId String    @map("practitioner_id") @db.Uuid
  serviceId      String    @map("service_id") @db.Uuid
  /// Tanggal layanan (kalender WIB).
  sessionDate    DateTime  @map("session_date") @db.Date
  startTime      DateTime  @map("start_time") @db.Time(0)
  endTime        DateTime  @map("end_time") @db.Time(0)
  /// praktik | cuti
  kind           String    @default("praktik")
  /// Dokter pengganti saat cuti.
  substituteId   String?   @map("substitute_practitioner_id") @db.Uuid
  quotaJkn       Int       @map("quota_jkn")
  quotaNonJkn    Int       @map("quota_non_jkn")
  bookedJkn      Int       @default(0) @map("booked_jkn")
  bookedNonJkn   Int       @default(0) @map("booked_non_jkn")
  note           String?
  /// Terakhir sama dengan HFIS.
  hfisSyncedAt   DateTime? @map("hfis_synced_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  schedule     PractitionerSchedule? @relation(fields: [tenantId, scheduleId], references: [tenantId, id])
  practitioner Practitioner          @relation("SessionPractitioner", fields: [tenantId, practitionerId], references: [tenantId, id])
  substitute   Practitioner?         @relation("SessionSubstitute", fields: [tenantId, substituteId], references: [tenantId, id])
  service      QueueService          @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  appointments Appointment[]

  @@unique([tenantId, id])
  @@unique([tenantId, practitionerId, sessionDate, startTime])
  @@index([tenantId, serviceId, sessionDate])
  @@map("schedule_sessions")
}

/// F01 · Salinan jadwal dari/ke HFIS untuk perbandingan RS vs HFIS. Append-only, tanpa PHI.
model HfisScheduleSnapshot {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  practitionerId String?  @map("practitioner_id") @db.Uuid
  /// pull | push
  direction      String
  periodStart    DateTime @map("period_start") @db.Date
  periodEnd      DateTime @map("period_end") @db.Date
  payload        Json
  fetchedAt      DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)
  createdBy      String?  @map("created_by") @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  practitioner Practitioner? @relation(fields: [tenantId, practitionerId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, fetchedAt])
  @@map("hfis_schedule_snapshots")
}

/// F02 · Booking (Mobile JKN, aplikasi RS, anjungan, loket). `booking_code` unik dan tidak bisa diubah.
model Appointment {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  /// Kode booking 10 digit (dikirim ke BPJS Antrean).
  bookingCode     String    @map("booking_code")
  patientId       String    @map("patient_id") @db.Uuid
  sessionId       String    @map("session_id") @db.Uuid
  practitionerId  String    @map("practitioner_id") @db.Uuid
  serviceId       String    @map("service_id") @db.Uuid
  appointmentDate DateTime  @map("appointment_date") @db.Date
  /// jkn | non_jkn (keranjang kuota sesi)
  quotaBucket     String    @map("quota_bucket")
  /// mobile_jkn | aplikasi | anjungan | loket
  channel         String
  /// booked | checked_in | cancelled | no_show | completed
  status          String    @default("booked")
  estimatedAt     DateTime? @map("estimated_at") @db.Timestamptz(3)
  checkedInAt     DateTime? @map("checked_in_at") @db.Timestamptz(3)
  cancelledAt     DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy     String?   @map("cancelled_by") @db.Uuid
  cancelReason    String?   @map("cancel_reason")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy       String?   @map("created_by") @db.Uuid
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy       String?   @map("updated_by") @db.Uuid

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  patient      Patient         @relation(fields: [tenantId, patientId], references: [tenantId, id])
  session      ScheduleSession @relation(fields: [tenantId, sessionId], references: [tenantId, id])
  practitioner Practitioner    @relation(fields: [tenantId, practitionerId], references: [tenantId, id])
  service      QueueService    @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  tickets      QueueTicket[]
  bpjsTasks    BpjsQueueTask[]
  encounters   Encounter[]

  @@unique([tenantId, id])
  @@unique([tenantId, bookingCode])
  @@index([tenantId, patientId])
  @@index([tenantId, sessionId])
  @@map("appointments")
}

/// F04 · Tiket antrean per layanan per hari (`allocateQueueNumber`). Nomor tidak bisa diubah.
model QueueTicket {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  serviceId     String   @map("service_id") @db.Uuid
  /// Tanggal layanan (kalender WIB).
  serviceDate   DateTime @map("service_date") @db.Date
  seq           Int
  /// `<kode layanan>-<3 digit>`, mis. `PD-027`.
  ticketNo      String   @map("ticket_no")
  appointmentId String?  @map("appointment_id") @db.Uuid
  patientId     String?  @map("patient_id") @db.Uuid
  /// anjungan | loket | booking | mobile_jkn
  source        String
  /// waiting | called | serving | done | skipped | cancelled
  status        String   @default("waiting")
  /// Dicadangkan untuk booking: hanya dipanggil petugas, bukan panggilan otomatis.
  reserved      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy     String?  @map("created_by") @db.Uuid
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy     String?  @map("updated_by") @db.Uuid

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  service     QueueService @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  appointment Appointment? @relation(fields: [tenantId, appointmentId], references: [tenantId, id])
  patient     Patient?     @relation(fields: [tenantId, patientId], references: [tenantId, id])
  calls       QueueCall[]
  encounters  Encounter[]

  @@unique([tenantId, id])
  @@unique([tenantId, serviceId, serviceDate, seq])
  @@index([tenantId, serviceId, serviceDate, status])
  @@map("queue_tickets")
}

/// F04 · Panggilan antrean (panggil, ulang, lewati, mulai, selesai). Append-only; setiap baris memicu
/// `pg_notify('queue_calls', {tenant_id, id})` untuk SSE papan (ADR-0026), tanpa isi lain.
model QueueCall {
  id       String   @id @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  ticketId String   @map("ticket_id") @db.Uuid
  /// call | recall | skip | start | finish
  action   String
  /// Loket/ruang pemanggil, mis. "Loket 3".
  counter  String?
  calledAt DateTime @default(now()) @map("called_at") @db.Timestamptz(3)
  calledBy String?  @map("called_by") @db.Uuid

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  ticket QueueTicket @relation(fields: [tenantId, ticketId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, ticketId, calledAt])
  @@map("queue_calls")
}

/// F04 · Task ID antrean BPJS per booking (1–7, 99 batal), dikirim lewat outbox. Satu baris per (booking, task);
/// task dan waktunya tidak bisa diubah, hanya status kirim.
model BpjsQueueTask {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  appointmentId   String    @map("appointment_id") @db.Uuid
  taskId          Int       @map("task_id") @db.SmallInt
  occurredAt      DateTime  @map("occurred_at") @db.Timestamptz(3)
  /// pending | sent | rejected | dead
  status          String    @default("pending")
  outboxMessageId String?   @map("outbox_message_id") @db.Uuid
  sentAt          DateTime? @map("sent_at") @db.Timestamptz(3)
  /// Kode galat BPJS terakhir (tanpa PHI).
  lastErrorCode   String?   @map("last_error_code")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  appointment Appointment @relation(fields: [tenantId, appointmentId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, appointmentId, taskId])
  @@map("bpjs_queue_tasks")
}

/// F03 · Kunjungan (FHIR Encounter): rawat jalan AMB, IGD EMER, rawat inap IMP. Nomor dari P08, tidak bisa diubah;
/// setiap perubahan status dicatat di `encounter_status_history`.
model Encounter {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// `RJ-2610-000123`, `IGD-…`, `RI-…`.
  number         String
  patientId      String    @map("patient_id") @db.Uuid
  /// AMB | EMER | IMP
  encounterClass String    @map("class")
  /// planned | arrived | in_progress | finished | cancelled
  status         String
  unitId         String    @map("unit_id") @db.Uuid
  serviceId      String?   @map("service_id") @db.Uuid
  /// DPJP.
  practitionerId String?   @map("practitioner_id") @db.Uuid
  appointmentId  String?   @map("appointment_id") @db.Uuid
  queueTicketId  String?   @map("queue_ticket_id") @db.Uuid
  arrivedAt      DateTime? @map("arrived_at") @db.Timestamptz(3)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  cancelReason   String?   @map("cancel_reason")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy      String?   @map("updated_by") @db.Uuid

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  patient         Patient                  @relation(fields: [tenantId, patientId], references: [tenantId, id])
  unit            Unit                     @relation(fields: [tenantId, unitId], references: [tenantId, id])
  service         QueueService?            @relation(fields: [tenantId, serviceId], references: [tenantId, id])
  practitioner    Practitioner?            @relation(fields: [tenantId, practitionerId], references: [tenantId, id])
  appointment     Appointment?             @relation(fields: [tenantId, appointmentId], references: [tenantId, id])
  queueTicket     QueueTicket?             @relation(fields: [tenantId, queueTicketId], references: [tenantId, id])
  statusHistory   EncounterStatusHistory[]
  coverages       Coverage[]
  referrals       Referral[]
  seps            Sep[]
  privacyConsents PrivacyConsent[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
  @@index([tenantId, patientId])
  @@index([tenantId, unitId, status])
  @@map("encounters")
}

/// F03 · Riwayat status kunjungan. Append-only.
model EncounterStatusHistory {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  encounterId String   @map("encounter_id") @db.Uuid
  fromStatus  String?  @map("from_status")
  toStatus    String   @map("to_status")
  reason      String?
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  changedBy   String?  @map("changed_by") @db.Uuid

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  encounter Encounter @relation(fields: [tenantId, encounterId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, encounterId, changedAt])
  @@map("encounter_status_history")
}

/// F06 · Penjaminan per kunjungan. Terkunci (`locked_at`, trigger) begitu SEP untuknya terbit.
model Coverage {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  encounterId         String    @map("encounter_id") @db.Uuid
  payerId             String    @map("payer_id") @db.Uuid
  /// Identifier peserta (mis. no. BPJS) di MPI; null untuk umum.
  patientIdentifierId String?   @map("patient_identifier_id") @db.Uuid
  /// 1 = utama, 2–3 = pendamping (koordinasi manfaat).
  priority            Int       @default(1) @db.SmallInt
  /// Hak kelas peserta: kelas_1 | kelas_2 | kelas_3
  classEntitlement    String?   @map("class_entitlement")
  /// Kelas rawat yang dipakai (bisa naik kelas).
  careClass           String?   @map("care_class")
  /// active | cancelled
  status              String    @default("active")
  lockedAt            DateTime? @map("locked_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy           String?   @map("created_by") @db.Uuid
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy           String?   @map("updated_by") @db.Uuid

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  encounter         Encounter          @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  payer             Payer              @relation(fields: [tenantId, payerId], references: [tenantId, id])
  patientIdentifier PatientIdentifier? @relation(fields: [tenantId, patientIdentifierId], references: [tenantId, id])
  seps              Sep[]

  @@unique([tenantId, id])
  @@index([tenantId, encounterId])
  @@map("coverages")
}

/// F07 · Rujukan masuk (FKTP/RS lain), surat kontrol, dan rujukan keluar/internal.
model Referral {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  patientId        String    @map("patient_id") @db.Uuid
  /// rujukan-fktp | rujukan-rs | surat-kontrol | rujukan-keluar | rujukan-internal
  kind             String
  number           String
  /// Kode PPK BPJS perujuk (masuk) atau tujuan (keluar).
  ppkCode          String?   @map("ppk_code")
  /// Nama faskes perujuk/tujuan atau poli asal surat kontrol.
  facilityName     String    @map("facility_name")
  /// Poli tujuan di RS ini.
  targetServiceId  String?   @map("target_service_id") @db.Uuid
  /// DPJP pengusul (surat kontrol) atau yang dituju.
  practitionerId   String?   @map("practitioner_id") @db.Uuid
  /// Kunjungan asal (keluar/kontrol) atau yang memakai rujukan ini.
  encounterId      String?   @map("encounter_id") @db.Uuid
  /// ICD-10 (kode baku dari data rujukan P06).
  diagnosisCode    String?   @map("diagnosis_code")
  diagnosisDisplay String?   @map("diagnosis_display")
  issuedOn         DateTime  @map("issued_on") @db.Date
  validUntil       DateTime? @map("valid_until") @db.Date
  /// Kunjungan ke- (rujukan FKTP berlaku untuk beberapa kunjungan).
  visitNo          Int?      @map("visit_no") @db.SmallInt
  /// active | used | expired | cancelled
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?   @map("updated_by") @db.Uuid

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  patient       Patient       @relation(fields: [tenantId, patientId], references: [tenantId, id])
  targetService QueueService? @relation(fields: [tenantId, targetServiceId], references: [tenantId, id])
  practitioner  Practitioner? @relation(fields: [tenantId, practitionerId], references: [tenantId, id])
  encounter     Encounter?    @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  seps          Sep[]

  @@unique([tenantId, id])
  @@unique([tenantId, kind, number])
  @@index([tenantId, patientId])
  @@map("referrals")
}

/// F06 · SEP (VClaim). Berversi: koreksi = baris baru (`supersedes_id`); baris `issued` beku kecuali dibatalkan,
/// baris `cancelled` beku seluruhnya (trigger). Satu rantai SEP per kunjungan (indeks unik versi 1).
model Sep {
  id               String    @id @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  encounterId      String    @map("encounter_id") @db.Uuid
  coverageId       String    @map("coverage_id") @db.Uuid
  referralId       String?   @map("referral_id") @db.Uuid
  version          Int       @default(1)
  supersedesId     String?   @map("supersedes_id") @db.Uuid
  correctionReason String?   @map("correction_reason")
  /// No. SEP dari VClaim (ada sejak terbit).
  sepNo            String?   @map("sep_no")
  /// pending | issued | failed | cancelled
  status           String    @default("pending")
  /// rawat_jalan | rawat_inap
  serviceType      String    @map("service_type")
  /// kelas_1 | kelas_2 | kelas_3
  careClass        String?   @map("care_class")
  /// Kode poli BPJS tujuan (rawat jalan).
  poliCode         String?   @map("poli_code")
  /// Diagnosa awal ICD-10.
  diagnosisCode    String?   @map("diagnosis_code")
  lastErrorCode    String?   @map("last_error_code")
  issuedAt         DateTime? @map("issued_at") @db.Timestamptz(3)
  cancelledAt      DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy      String?   @map("cancelled_by") @db.Uuid
  cancelReason     String?   @map("cancel_reason")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?   @map("created_by") @db.Uuid
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy        String?   @map("updated_by") @db.Uuid

  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  encounter    Encounter @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  coverage     Coverage  @relation(fields: [tenantId, coverageId], references: [tenantId, id])
  referral     Referral? @relation(fields: [tenantId, referralId], references: [tenantId, id])
  supersedes   Sep?      @relation("SepVersion", fields: [tenantId, supersedesId], references: [tenantId, id])
  supersededBy Sep[]     @relation("SepVersion")

  @@unique([tenantId, id])
  @@index([tenantId, encounterId])
  @@index([tenantId, sepNo])
  @@map("seps")
}

/// F03 · Keluarga/penanggung jawab pasien. Nama, no. HP, alamat terenkripsi (`encryptField`, tujuan `contact`).
/// Append-only: mengganti = baris baru dengan `supersedes_id`; menghapus = baris baru berstatus `removed`.
model PatientContact {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  /// suami | istri | anak | orang_tua | saudara | wali | lainnya
  relation     String
  nameEnc      String   @map("name_enc")
  phoneEnc     String?  @map("phone_enc")
  addressEnc   String?  @map("address_enc")
  /// Penanggung jawab administratif pasien.
  isGuarantor  Boolean  @default(false) @map("is_guarantor")
  /// active | removed
  status       String   @default("active")
  supersedesId String?  @map("supersedes_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String?  @map("created_by") @db.Uuid

  tenant       Tenant           @relation(fields: [tenantId], references: [id])
  patient      Patient          @relation(fields: [tenantId, patientId], references: [tenantId, id])
  supersedes   PatientContact?  @relation("ContactVersion", fields: [tenantId, supersedesId], references: [tenantId, id])
  supersededBy PatientContact[] @relation("ContactVersion")

  @@unique([tenantId, id])
  @@index([tenantId, patientId])
  @@map("patient_contacts")
}
