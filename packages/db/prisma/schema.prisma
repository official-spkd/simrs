// Skema SIM RS. Konvensi: docs/04-data-model.md §1.
// - PK UUID v7 dibangkitkan aplikasi; tabel domain punya tenant_id + RLS (lihat migrasi, ADR-0002, ADR-0008).
// - Nama tabel/kolom snake_case jamak; model Prisma PascalCase.
// - Kebijakan RLS, GRANT, trigger, dan fungsi ditulis manual di migration.sql (Prisma tidak memodelkannya).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// P01 · Tenant = satu RS, atau satu tenant khusus operator platform (kind = platform, ADR-0013).
/// RLS: baris hanya terlihat oleh tenant itu sendiri.
model Tenant {
  id             String   @id @db.Uuid
  code           String   @unique
  name           String
  kemenkesCode   String?  @map("kemenkes_code")
  bpjsPpkCode    String?  @map("bpjs_ppk_code")
  satusehatOrgId String?  @map("satusehat_org_id")
  hospitalClass  String?  @map("hospital_class")
  status         String   @default("active")
  /// hospital | platform (hanya satu tenant platform; indeks unik parsial di migrasi).
  kind           String   @default("hospital")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  outboxMessages   OutboxMessage[]
  deliveryAttempts DeliveryAttempt[]
  inboundEvents    InboundEvent[]
  auditEvents      AuditEvent[]
  facilities       Facility[]
  units            Unit[]
  locations        Location[]
  modules          TenantModule[]
  settings         TenantSetting[]
  numberSequences  NumberSequence[]
  domains          TenantDomain[]
  users            User[]
  credentials      UserCredential[]
  mfaFactors       MfaFactor[]
  sessions         AuthSession[]
  loginChallenges  LoginChallenge[]
  roles            Role[]
  rolePermissions  RolePermission[]
  assignments      StaffAssignment[]
  relationships    AccessRelationship[]
  breakGlassGrants BreakGlassGrant[]
  notifications    Notification[]
  patients         Patient[]
  identifiers      PatientIdentifier[]
  matchCandidates  PatientMatchCandidate[]
  patientLinks     PatientLink[]
  privacyConsents  PrivacyConsent[]
  formDefinitions  FormDefinition[]
  formResponses    FormResponse[]
  documents        Document[]
  signatures       DocumentSignature[]
  trustedDevices   TrustedDevice[]
  devices          RegisteredDevice[]
  backupRuns       BackupRun[]
  restoreTests     RestoreTest[]

  @@map("tenants")
}

/// I01 · Transactional outbox (ADR-0003). Ditulis dalam transaksi domain; dikirim worker.
model OutboxMessage {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  target         String
  operation      String
  idempotencyKey String    @map("idempotency_key")
  payload        Json
  status         String    @default("pending")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError      String?   @map("last_error")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(3)
  deadAt         DateTime? @map("dead_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  deliveries DeliveryAttempt[]

  @@unique([tenantId, target, idempotencyKey])
  @@index([tenantId, status, nextAttemptAt])
  @@map("outbox_messages")
}

/// Jejak setiap percobaan kirim (request/response tersamar, durasi, kode).
model DeliveryAttempt {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  outboxMessageId String   @map("outbox_message_id") @db.Uuid
  attemptNo       Int      @map("attempt_no")
  startedAt       DateTime @map("started_at") @db.Timestamptz(3)
  durationMs      Int      @map("duration_ms")
  statusCode      Int?     @map("status_code")
  outcome         String
  error           String?
  responseExcerpt String?  @map("response_excerpt")

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  outboxMessage OutboxMessage @relation(fields: [outboxMessageId], references: [id])

  @@index([tenantId, outboxMessageId])
  @@map("delivery_attempts")
}

/// Webhook masuk mentah (TPDI, BTN). Unik per sumber + idempotency key; diproses async.
model InboundEvent {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  source         String
  idempotencyKey String    @map("idempotency_key")
  headers        Json
  rawBody        String    @map("raw_body")
  status         String    @default("received")
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)
  error          String?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, source, idempotencyKey])
  @@map("inbound_events")
}

/// P04 · Audit trail append-only dengan hash berantai per tenant. seq, prev_hash, hash, dan occurred_at
/// diisi trigger database (app_audit_chain), bukan aplikasi. UPDATE/DELETE ditolak.
model AuditEvent {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  /// Nomor urut per tenant (1, 2, 3, …); celah = baris hilang.
  seq          BigInt   @default(0)
  occurredAt   DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  actorRole    String?  @map("actor_role")
  patientId    String?  @map("patient_id") @db.Uuid
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  action       String
  /// success | denied
  outcome      String   @default("success")
  reason       String?
  ip           String?
  userAgent    String?  @map("user_agent")
  requestId    String?  @map("request_id")
  /// Metadata tanpa PHI (mis. nama field yang berubah, jumlah hasil pencarian).
  details      Json?
  prevHash     String?  @map("prev_hash")
  hash         String   @default("")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, seq])
  @@index([tenantId, occurredAt])
  @@index([tenantId, patientId, occurredAt])
  @@index([tenantId, actorUserId, occurredAt])
  @@map("audit_events")
}

/// P01 · Faskes/cabang milik tenant (RS). Master: tidak dihapus, dinonaktifkan (active = false).
model Facility {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  code         String
  name         String
  kemenkesCode String?  @map("kemenkes_code")
  address      String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy    String?  @map("created_by") @db.Uuid
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy    String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  units  Unit[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("facilities")
}

/// P01 · Unit layanan (instalasi, poli, IGD, bangsal, penunjang, farmasi, OK, administrasi).
model Unit {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  facilityId String   @map("facility_id") @db.Uuid
  parentId   String?  @map("parent_id") @db.Uuid
  code       String
  name       String
  kind       String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?  @map("created_by") @db.Uuid
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?  @map("updated_by") @db.Uuid

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  /// FK komposit: unit hanya bisa menunjuk faskes milik tenant yang sama (FK tidak tunduk RLS).
  facility    Facility          @relation(fields: [tenantId, facilityId], references: [tenantId, id])
  parent      Unit?             @relation("UnitTree", fields: [tenantId, parentId], references: [tenantId, id])
  children    Unit[]            @relation("UnitTree")
  locations   Location[]
  assignments StaffAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, facilityId])
  @@map("units")
}

/// P01 · Lokasi fisik: ruang → kamar → bed. Kelas perawatan dipakai Aplicare/BPJS dan tarif.
model Location {
  id                  String   @id @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  unitId              String   @map("unit_id") @db.Uuid
  parentId            String?  @map("parent_id") @db.Uuid
  kind                String
  code                String
  name                String
  careClass           String?  @map("care_class")
  satusehatLocationId String?  @map("satusehat_location_id")
  active              Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy           String?  @map("created_by") @db.Uuid
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy           String?  @map("updated_by") @db.Uuid

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  unit     Unit       @relation(fields: [tenantId, unitId], references: [tenantId, id])
  parent   Location?  @relation("LocationTree", fields: [tenantId, parentId], references: [tenantId, id])
  children Location[] @relation("LocationTree")

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, unitId])
  @@map("locations")
}

/// P10 · Modul aktif per RS (feature flag). Tidak ada baris = bawaan katalog (MVP aktif).
model TenantModule {
  tenantId   String   @map("tenant_id") @db.Uuid
  moduleCode String   @map("module_code")
  enabled    Boolean
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, moduleCode])
  @@map("tenant_modules")
}

/// P12 · Pengaturan per RS. Kunci dan bentuk nilai divalidasi registri di @simrs/shared (kunci asing ditolak).
model TenantSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
  @@map("tenant_settings")
}

/// P08 · Penomoran dokumen per tenant × jenis × periode. Nilai hanya naik; nomor tidak pernah dipakai ulang.
model NumberSequence {
  tenantId  String   @map("tenant_id") @db.Uuid
  kind      String
  /// '' untuk nomor tanpa periode (No. RM), 'YYMM' untuk dokumen bulanan.
  period    String
  lastValue BigInt   @map("last_value")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, kind, period])
  @@map("number_sequences")
}

/// P02 · Pemetaan host (subdomain) → tenant untuk login produksi. Registri platform: aplikasi tidak punya GRANT,
/// hanya fungsi app_resolve_tenant_by_host() yang membacanya.
model TenantDomain {
  host      String   @id
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("tenant_domains")
}

/// P02 · Akun per orang (tanpa akun bersama). Tidak dihapus; dinonaktifkan (status = disabled).
model User {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  /// NIP atau email RS, selalu huruf kecil (CHECK di database).
  username           String
  displayName        String    @map("display_name")
  email              String?
  /// No. HP staf terenkripsi (`staff_phone`, bentuk baku 62…): WhatsApp notifikasi + kode cadangan login.
  phoneEnc           String?   @map("phone_enc")
  /// active | disabled
  status             String    @default("active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  failedLoginCount   Int       @default(0) @map("failed_login_count")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz(3)
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy          String?   @map("updated_by") @db.Uuid

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  credential          UserCredential?
  mfaFactors          MfaFactor[]
  sessions            AuthSession[]
  loginChallenges     LoginChallenge[]
  assignments         StaffAssignment[]
  accessRelationships AccessRelationship[]
  breakGlassGrants    BreakGlassGrant[]    @relation("BreakGlassUser")
  breakGlassReviews   BreakGlassGrant[]    @relation("BreakGlassReviewer")
  notifications       Notification[]
  signatures          DocumentSignature[]
  trustedDevices      TrustedDevice[]
  devices             RegisteredDevice[]   @relation("RegisteredDeviceUser")
  devicesRevoked      RegisteredDevice[]   @relation("RegisteredDeviceRevoker")

  @@unique([tenantId, id])
  @@unique([tenantId, username])
  @@unique([tenantId, email])
  @@map("users")
}

/// P02 · Hash kata sandi (argon2id) dipisah dari users agar tidak ikut terbaca query pengguna biasa.
model UserCredential {
  userId       String   @id @map("user_id") @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  passwordHash String   @map("password_hash")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@unique([tenantId, userId])
  @@map("user_credentials")
}

/// P02 · Faktor MFA. Rahasia TOTP terenkripsi (AES-256-GCM, kunci per tenant). last_used_step mencegah replay.
model MfaFactor {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  kind         String    @default("totp")
  secretEnc    String    @map("secret_enc")
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(3)
  lastUsedStep Int?      @map("last_used_step")
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@index([tenantId, userId])
  @@map("mfa_factors")
}

/// P02 · Sesi login. Token buram (bukan JWT): yang disimpan hanya hash SHA-256; dicek di setiap permintaan
/// sehingga logout/pencabutan berlaku seketika. Refresh token berotasi; pemakaian ulang token lama → sesi dicabut.
model AuthSession {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  accessHash          String    @map("access_hash")
  accessExpiresAt     DateTime  @map("access_expires_at") @db.Timestamptz(3)
  refreshHash         String    @map("refresh_hash")
  previousRefreshHash String?   @map("previous_refresh_hash")
  refreshExpiresAt    DateTime  @map("refresh_expires_at") @db.Timestamptz(3)
  lastSeenAt          DateTime  @map("last_seen_at") @db.Timestamptz(3)
  idleTimeoutMinutes  Int       @map("idle_timeout_minutes")
  mfaVerified         Boolean   @default(false) @map("mfa_verified")
  unitId              String?   @map("unit_id") @db.Uuid
  /// P03 · Penugasan aktif yang dipilih (menentukan peran dan unit sesi).
  assignmentId        String?   @map("assignment_id") @db.Uuid
  /// P02 · Perangkat terdaftar yang membuka sesi ini dengan PIN (ADR-0024): posisi terkunci ke posisi pendaftaran
  /// PIN, sesi pendek, dan sesi ikut berakhir saat PIN perangkat itu dicabut.
  deviceId            String?   @map("device_id") @db.Uuid
  /// active | revoked
  status              String    @default("active")
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason       String?   @map("revoked_reason")
  ip                  String?
  userAgent           String?   @map("user_agent")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  user       User              @relation(fields: [tenantId, userId], references: [tenantId, id])
  assignment StaffAssignment?  @relation(fields: [tenantId, assignmentId], references: [tenantId, id])
  device     RegisteredDevice? @relation(fields: [tenantId, deviceId], references: [tenantId, id])

  @@index([tenantId, userId, status])
  @@index([tenantId, deviceId])
  @@map("auth_sessions")
}

/// P02 · Tantangan MFA setelah kata sandi benar (berlaku 5 menit, maksimal 5 percobaan, sekali pakai).
model LoginChallenge {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  secretHash String    @map("secret_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Kode cadangan 6 digit (WhatsApp/email) terenkripsi `login_otp`; berlaku selama tantangan, berbagi batas
  /// percobaan dengan TOTP.
  otpEnc     String?   @map("otp_enc")
  /// whatsapp | email
  otpChannel String?   @map("otp_channel")
  otpSentAt  DateTime? @map("otp_sent_at") @db.Timestamptz(3)
  otpSends   Int       @default(0) @map("otp_sends")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@map("login_challenges")
}

/// P03 · Peran per RS. Peran sistem (16 bawaan) dibuat otomatis; matriks izinnya bisa diubah per RS.
model Role {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  name      String
  isSystem  Boolean  @default(true) @map("is_system")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  assignments StaffAssignment[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("roles")
}

/// P03 · Izin peran: sumber × aksi × lingkup (all | unit | relationship). Katalog sah di @simrs/shared.
model RolePermission {
  tenantId  String   @map("tenant_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  resource  String
  action    String
  scope     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy String?  @map("updated_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id])

  @@id([roleId, resource, action])
  @@index([tenantId, roleId])
  @@map("role_permissions")
}

/// P03 · Penugasan staf: pengguna × peran × unit × periode. Tidak dihapus; diakhiri dengan valid_until.
model StaffAssignment {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  roleId     String    @map("role_id") @db.Uuid
  unitId     String?   @map("unit_id") @db.Uuid
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)
  endReason  String?   @map("end_reason")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy  String?   @map("updated_by") @db.Uuid

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  user     User               @relation(fields: [tenantId, userId], references: [tenantId, id])
  role     Role               @relation(fields: [tenantId, roleId], references: [tenantId, id])
  unit     Unit?              @relation(fields: [tenantId, unitId], references: [tenantId, id])
  sessions AuthSession[]
  devices  RegisteredDevice[]

  @@unique([tenantId, id])
  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@map("staff_assignments")
}

/// P03 · Relasi klinisi–pasien untuk ABAC (DPJP, perawat penanggung jawab, rawat bersama, konsultan).
/// Diisi modul klinis (fase 2–3) dari encounter; FK ke patients ditambahkan saat tabel pasien dibuat (P05).
model AccessRelationship {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  patientId  String    @map("patient_id") @db.Uuid
  kind       String
  validFrom  DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validUntil DateTime? @map("valid_until") @db.Timestamptz(3)
  sourceType String?   @map("source_type")
  sourceId   String?   @map("source_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  user    User    @relation(fields: [tenantId, userId], references: [tenantId, id])
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@index([tenantId, userId, patientId])
  @@index([tenantId, patientId])
  @@map("access_relationships")
}

/// P03 · Akses darurat (break-the-glass): alasan wajib, berbatas waktu, ditinjau petugas privasi.
/// Aplikasi hanya boleh mengubah kolom tinjauan (column privilege); alasan & waktu tidak bisa diubah.
model BreakGlassGrant {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  patientId     String    @map("patient_id") @db.Uuid
  reason        String
  grantedAt     DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  reviewOutcome String?   @map("review_outcome")
  reviewNote    String?   @map("review_note")
  reviewedBy    String?   @map("reviewed_by") @db.Uuid
  reviewedAt    DateTime? @map("reviewed_at") @db.Timestamptz(3)

  tenant   Tenant  @relation(fields: [tenantId], references: [id])
  user     User    @relation("BreakGlassUser", fields: [tenantId, userId], references: [tenantId, id])
  reviewer User?   @relation("BreakGlassReviewer", fields: [tenantId, reviewedBy], references: [tenantId, id])
  patient  Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@index([tenantId, userId, patientId, expiresAt])
  @@index([tenantId, reviewOutcome])
  @@map("break_glass_grants")
}

/// P11 (awal) · Notifikasi in-app. Tanpa PHI di judul/isi; tautan ke halaman yang menerapkan izin.
model Notification {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  recipientUserId String    @map("recipient_user_id") @db.Uuid
  kind            String
  title           String
  body            String
  link            String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt          DateTime? @map("read_at") @db.Timestamptz(3)

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  recipient User   @relation(fields: [tenantId, recipientUserId], references: [tenantId, id])

  @@index([tenantId, recipientUserId, readAt])
  @@map("notifications")
}

/// P05 · Master Patient Index. Satu baris = satu rekam medis (nomor RM). Data identitas, bukan entri klinis:
/// boleh diubah (diaudit per nama field), tidak pernah dihapus. Penggabungan = penanda `merged` + rujukan ke
/// rekam medis yang dipertahankan (P05, potongan 7b); nomor RM tidak berubah.
/// NIK dan identifier lain di `patient_identifiers`; alamat dan no. HP dienkripsi di aplikasi (docs/04 §1).
model Patient {
  id                 String    @id @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  /// Nomor rekam medis `00-41-27-88` dari layanan penomoran (P08, jenis `mrn`). Tidak bisa diubah (hak kolom).
  mrn                String
  name               String
  /// Nama ternormalisasi untuk trigram/duplikat (`normalizePersonName`), indeks GIN di migrasi.
  nameSearch         String    @map("name_search")
  /// male | female | unknown (kode FHIR gender)
  sex                String
  birthDate          DateTime? @map("birth_date") @db.Date
  birthDateEstimated Boolean   @default(false) @map("birth_date_estimated")
  motherName         String?   @map("mother_name")
  /// AES-256-GCM (`encryptField`, tujuan `contact`).
  addressEnc         String?   @map("address_enc")
  phoneEnc           String?   @map("phone_enc")
  /// Blind index HMAC no. HP baku `62…` untuk pencocokan duplikat.
  phoneHash          String?   @map("phone_hash")
  /// Pasien tanpa identitas (mis. IGD tidak sadar, "Tn. X").
  unidentified       Boolean   @default(false)
  /// active | merged
  status             String    @default("active")
  mergedIntoId       String?   @map("merged_into_id") @db.Uuid
  mergedAt           DateTime? @map("merged_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String?   @map("created_by") @db.Uuid
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy          String?   @map("updated_by") @db.Uuid

  tenant          Tenant                  @relation(fields: [tenantId], references: [id])
  mergedInto      Patient?                @relation("PatientMerge", fields: [tenantId, mergedIntoId], references: [tenantId, id])
  mergedFrom      Patient[]               @relation("PatientMerge")
  identifiers     PatientIdentifier[]
  relationships   AccessRelationship[]
  breakGlass      BreakGlassGrant[]
  matchesAsA      PatientMatchCandidate[] @relation("MatchA")
  matchesAsB      PatientMatchCandidate[] @relation("MatchB")
  linksAsSurvivor PatientLink[]           @relation("LinkSurvivor")
  linksAsMerged   PatientLink[]           @relation("LinkMerged")
  consents        PrivacyConsent[]
  formResponses   FormResponse[]
  documents       Document[]

  @@unique([tenantId, id])
  @@unique([tenantId, mrn])
  @@index([tenantId, birthDate])
  @@index([tenantId, phoneHash])
  @@index([tenantId, mergedIntoId])
  /// Pencarian nama mirip (pg_trgm; btree_gin untuk tenant_id).
  @@index([tenantId(ops: raw("uuid_ops")), nameSearch(ops: raw("gin_trgm_ops"))], map: "patients_name_search_trgm", type: Gin)
  @@map("patients")
}

/// P05 · Identifier eksternal pasien (NIK, no. BPJS, IHS SATUSEHAT, paspor). Nilai terenkripsi + blind index.
/// Nilai tidak pernah diubah: koreksi = baris baru, baris lama dinonaktifkan dengan alasan (hak kolom).
/// Maksimal satu identifier aktif per sistem per pasien (indeks unik parsial di migrasi).
model PatientIdentifier {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  patientId           String    @map("patient_id") @db.Uuid
  /// nik | bpjs | ihs | paspor
  system              String
  /// AES-256-GCM (`encryptField`, tujuan `patient_identifier`).
  valueEnc            String    @map("value_enc")
  /// HMAC `sistem:nilai` (`blindIndex`) untuk pencarian sama-persis tanpa menyimpan nilai.
  valueHash           String    @map("value_hash")
  active              Boolean   @default(true)
  /// unverified | pending | verified | mismatch | not_found (verifikasi Dukcapil, potongan 7c)
  verificationStatus  String    @default("unverified") @map("verification_status")
  verifiedAt          DateTime? @map("verified_at") @db.Timestamptz(3)
  /// Hasil verifikasi tanpa PHI (mis. field yang tidak cocok).
  verificationDetails Json?     @map("verification_details")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy           String?   @map("created_by") @db.Uuid
  deactivatedAt       DateTime? @map("deactivated_at") @db.Timestamptz(3)
  deactivatedBy       String?   @map("deactivated_by") @db.Uuid
  deactivationReason  String?   @map("deactivation_reason")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, system, valueHash])
  @@index([tenantId, patientId])
  @@map("patient_identifiers")
}

/// P05 · Pasangan kemungkinan rekam medis ganda (antrean layar MPI). A = rekam medis lebih lama (usulan
/// dipertahankan), B = lebih baru (usulan digabungkan). Satu baris per pasangan tak berurutan (indeks unik di
/// migrasi). Alasan berupa kode tanpa PHI. Keputusan petugas tercatat di sini dan di jejak audit.
model PatientMatchCandidate {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  patientAId     String    @map("patient_a_id") @db.Uuid
  patientBId     String    @map("patient_b_id") @db.Uuid
  /// 0–99 (`scorePatientMatch`).
  score          Int
  /// Kode alasan (`MATCH_REASONS`), larik JSON.
  reasons        Json
  /// open | merged | distinct | superseded
  status         String    @default("open")
  detectedAt     DateTime  @default(now()) @map("detected_at") @db.Timestamptz(3)
  decidedAt      DateTime? @map("decided_at") @db.Timestamptz(3)
  decidedBy      String?   @map("decided_by") @db.Uuid
  decisionReason String?   @map("decision_reason")
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  patientA Patient       @relation("MatchA", fields: [tenantId, patientAId], references: [tenantId, id])
  patientB Patient       @relation("MatchB", fields: [tenantId, patientBId], references: [tenantId, id])
  links    PatientLink[]

  @@unique([tenantId, id])
  @@index([tenantId, status, score])
  @@index([tenantId, patientAId])
  @@index([tenantId, patientBId])
  @@map("patient_match_candidates")
}

/// P05 · Jejak penggabungan: rekam medis B (`merged`) digabung ke A (`survivor`). Tidak ada data yang dipindah
/// atau dihapus; pembatalan (≤ 30 hari) hanya mengisi kolom `undone_*` (hak kolom).
model PatientLink {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  survivorId          String    @map("survivor_id") @db.Uuid
  mergedId            String    @map("merged_id") @db.Uuid
  candidateId         String?   @map("candidate_id") @db.Uuid
  reason              String
  /// Nama atribut yang diambil dari B (`MERGE_ATTRIBUTES`), tanpa nilai.
  takenAttributes     Json      @default("[]") @map("taken_attributes")
  /// Nilai A sebelum ditimpa: JSON terenkripsi (tujuan `patient_snapshot`) untuk pemulihan saat dibatalkan.
  survivorSnapshotEnc String?   @map("survivor_snapshot_enc")
  mergedAt            DateTime  @default(now()) @map("merged_at") @db.Timestamptz(3)
  mergedBy            String?   @map("merged_by") @db.Uuid
  undoneAt            DateTime? @map("undone_at") @db.Timestamptz(3)
  undoneBy            String?   @map("undone_by") @db.Uuid
  undoReason          String?   @map("undo_reason")

  tenant    Tenant                 @relation(fields: [tenantId], references: [id])
  survivor  Patient                @relation("LinkSurvivor", fields: [tenantId, survivorId], references: [tenantId, id])
  merged    Patient                @relation("LinkMerged", fields: [tenantId, mergedId], references: [tenantId, id])
  candidate PatientMatchCandidate? @relation(fields: [tenantId, candidateId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, survivorId])
  @@index([tenantId, candidateId])
  @@map("patient_links")
}

/// P05 · Persetujuan privasi pasien (docs/05 §1, UU PDP): persetujuan umum dan pembukaan data ke pihak ketiga.
/// Dicatat atas nama petugas; pencabutan mengisi kolom `revoked_*` (hak kolom), baris tidak pernah dihapus.
model PrivacyConsent {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  /// umum | pembukaan_data
  kind         String
  /// Penerima data (wajib untuk pembukaan data), mis. nama asuransi.
  recipient    String?
  note         String?
  givenAt      DateTime  @default(now()) @map("given_at") @db.Timestamptz(3)
  givenBy      String?   @map("given_by") @db.Uuid
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedBy    String?   @map("revoked_by") @db.Uuid
  revokeReason String?   @map("revoke_reason")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [tenantId, patientId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, patientId])
  @@map("privacy_consents")
}

/// P07 · Definisi formulir klinis berversi (formulir = data, MRMIK 6c). Satu versi berlaku (`published`) dan
/// paling banyak satu draf terbuka per kode (indeks unik parsial). Isi versi terbit/arsip tidak bisa diubah
/// (trigger `app_form_definition_guard`): isian lama selalu terbaca dengan versi saat diisi.
model FormDefinition {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  code        String
  version     Int
  title       String
  /// keperawatan | medis | kebidanan | umum
  category    String
  /// draft | submitted | published | archived
  status      String    @default("draft")
  /// Bagian, field, opsi, skor, logika tampil (`formSchemaSchema` di @simrs/shared).
  schema      Json
  /// Kode peran yang boleh mengisi (hak tulis per profesi, MRMIK 10a).
  writeRoles  String[]  @map("write_roles")
  changeNote  String    @map("change_note")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?   @map("created_by") @db.Uuid
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedBy   String?   @map("updated_by") @db.Uuid
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)
  submittedBy String?   @map("submitted_by") @db.Uuid
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  publishedBy String?   @map("published_by") @db.Uuid
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(3)

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  responses FormResponse[]

  @@unique([tenantId, id])
  @@unique([tenantId, code, version])
  @@map("form_definitions")
}

/// P07 · Isian formulir untuk pasien. Append-only (ADR-0004): koreksi = baris baru (`version` + 1,
/// `supersedes_id`, `correction_reason`); tidak ada UPDATE/DELETE (hak + trigger). Kelompok versi = `root_id`.
model FormResponse {
  id               String   @id @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  patientId        String   @map("patient_id") @db.Uuid
  /// Versi definisi yang dipakai saat diisi (bukan selalu versi terbaru).
  definitionId     String   @map("definition_id") @db.Uuid
  formCode         String   @map("form_code")
  version          Int      @default(1)
  /// ID versi 1 (kelompok semua versi isian ini).
  rootId           String   @map("root_id") @db.Uuid
  supersedesId     String?  @map("supersedes_id") @db.Uuid
  /// final | entered_in_error
  status           String   @default("final")
  answers          Json
  score            Int?
  scoreBand        String?  @map("score_band")
  correctionReason String?  @map("correction_reason")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy        String?  @map("created_by") @db.Uuid

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  patient      Patient        @relation(fields: [tenantId, patientId], references: [tenantId, id])
  definition   FormDefinition @relation(fields: [tenantId, definitionId], references: [tenantId, id])
  supersedes   FormResponse?  @relation("FormResponseVersion", fields: [tenantId, supersedesId], references: [tenantId, id])
  supersededBy FormResponse[] @relation("FormResponseVersion")

  @@unique([tenantId, id])
  @@unique([tenantId, rootId, version])
  @@index([tenantId, patientId, formCode])
  @@map("form_responses")
}

/// P08 · Dokumen pasien (lampiran foto/scan, hasil, surat). Berkas ada di penyimpanan objek dengan kunci acak
/// (`storage_key`); baris ini hanya metadata + SHA-256 isi berkas. Tidak pernah diubah atau dihapus: salah
/// unggah ditandai batal sekali dengan alasan, dan dokumen bertanda tangan tidak bisa dibatalkan (trigger,
/// ADR-0020).
model Document {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  patientId  String    @map("patient_id") @db.Uuid
  /// lampiran | hasil | surat | resume | consent | lainnya
  kind       String
  title      String
  /// Nama untuk tampilan/unduhan saja (sudah disaring).
  fileName   String    @map("file_name")
  /// Dikenali dari isi berkas: application/pdf | image/png | image/jpeg
  mimeType   String    @map("mime_type")
  sizeBytes  Int       @map("size_bytes")
  sha256     String
  storageKey String    @unique @map("storage_key")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?   @map("created_by") @db.Uuid
  voidedAt   DateTime? @map("voided_at") @db.Timestamptz(3)
  voidedBy   String?   @map("voided_by") @db.Uuid
  voidReason String?   @map("void_reason")

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  patient    Patient             @relation(fields: [tenantId, patientId], references: [tenantId, id])
  signatures DocumentSignature[]

  @@unique([tenantId, id])
  @@index([tenantId, patientId, createdAt])
  @@map("documents")
}

/// P08 · Tanda tangan elektronik atas hash dokumen, dimintakan ke penyelenggara TTE lewat outbox. Satu
/// penanda tangan sekali per dokumen; hash yang ditandatangani wajib sama dengan hash dokumen, dan setelah
/// `signed` baris terkunci (trigger). `verify_code` dicetak sebagai QR untuk verifikasi publik tanpa PHI.
model DocumentSignature {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  documentId          String    @map("document_id") @db.Uuid
  signerUserId        String    @map("signer_user_id") @db.Uuid
  documentSha256      String    @map("document_sha256")
  /// pending | signed
  status              String    @default("pending")
  verifyCode          String    @unique @map("verify_code")
  requestedAt         DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  signedAt            DateTime? @map("signed_at") @db.Timestamptz(3)
  providerSignatureId String?   @map("provider_signature_id")
  certificate         String?
  signature           String?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  document Document @relation(fields: [tenantId, documentId], references: [tenantId, id])
  signer   User     @relation(fields: [tenantId, signerUserId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, documentId, signerUserId])
  @@map("document_signatures")
}

/// P02 · "Percayai perangkat ini" (mockup Login): selama berlaku, login dengan sandi di perangkat ini melewati
/// langkah MFA. Token buram di cookie httpOnly; di sini hanya hash-nya. Dicabut saat sandi/MFA direset atau akun
/// dinonaktifkan.
model TrustedDevice {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  /// Ringkas (maks. 200 karakter), untuk ditampilkan/ditinjau.
  userAgent  String?   @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, userId])
  @@map("trusted_devices")
}

/// P02 · Perangkat terdaftar (docs/05 §1, ADR-0024). Jenis `staff_pin` = PIN masuk cepat: satu baris = satu akun ×
/// satu perangkat (peramban) × satu posisi berunit, didaftarkan dari login penuh di perangkat itu sendiri. Token buram
/// `sd1` di cookie httpOnly peramban; di sini hanya hash-nya. PIN disimpan argon2id dari HMAC berlada
/// (FIELD_HASH_KEY) yang terikat tenant + akun + perangkat. Fase 2 memakai ulang tabel ini untuk anjungan/TV (jenis
/// baru, kolom khusus PIN kosong). Tidak dihapus: pencabutan = kolom `revoked_*`, final (dijaga trigger).
model RegisteredDevice {
  id             String    @id @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  /// staff_pin (CHECK database; jenis lain menyusul fase 2)
  kind           String    @default("staff_pin")
  /// staff_pin: pemilik PIN (wajib untuk jenis ini, CHECK `registered_devices_staff_pin`).
  userId         String?   @map("user_id") @db.Uuid
  /// staff_pin: posisi (penugasan) yang dibuka sesi PIN; unitnya = unit tempat perangkat terdaftar.
  assignmentId   String?   @map("assignment_id") @db.Uuid
  /// Nama perangkat dari pengguna (mis. "Komputer nurse station Melati").
  name           String
  tokenHash      String    @unique @map("token_hash")
  /// staff_pin: argon2id dari HMAC berlada atas tenant + perangkat + akun + PIN.
  pinHash        String?   @map("pin_hash")
  /// Percobaan salah berturut-turut, dicadangkan sebelum PIN diperiksa (aman dari tebakan paralel); maks. 5.
  failedAttempts Int       @default(0) @map("failed_attempts")
  /// Ringkas (maks. 200 karakter), untuk ditampilkan/ditinjau.
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// staff_pin: maks. 30 hari setelah didaftarkan (CHECK database).
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt     DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// user_removed | admin_revoked | too_many_attempts | password_changed | password_reset | mfa_reset |
  /// user_disabled | assignment_ended
  revokedReason  String?   @map("revoked_reason")
  /// Pengguna yang mencabut (pemilik atau admin); kosong untuk pencabutan sistem (mis. terlalu banyak salah).
  revokedBy      String?   @map("revoked_by") @db.Uuid

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  user       User?            @relation("RegisteredDeviceUser", fields: [tenantId, userId], references: [tenantId, id])
  assignment StaffAssignment? @relation(fields: [tenantId, assignmentId], references: [tenantId, id])
  revoker    User?            @relation("RegisteredDeviceRevoker", fields: [tenantId, revokedBy], references: [tenantId, id])
  sessions   AuthSession[]

  @@unique([tenantId, id])
  @@index([tenantId, userId])
  @@map("registered_devices")
}

/// Fase 10 · Backup terenkripsi tiga lokasi (ADR-0071). Baris milik tenant PLATFORM (bukan data RS), append-only, dan
/// hanya ditulis lewat `app_record_backup_run()` oleh peran ops `simrs_backup`. RS membaca ringkasan lewat
/// `app_backup_status()` (tanpa lokasi, kunci, atau ukuran).
model BackupRun {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  /// `<UTC yyyymmddThhmmssZ>-<kind>`, sama dengan nama folder backup di ketiga lokasi.
  backupKey      String   @map("backup_key")
  /// hourly | daily | manual
  kind           String
  /// success (ketiga lokasi) | partial (dump ada, minimal satu lokasi gagal) | failed
  status         String
  startedAt      DateTime @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime @map("finished_at") @db.Timestamptz(3)
  /// Lokasi yang berhasil: local | cloud | offsite
  locationsOk    String[] @map("locations_ok")
  dbBytes        BigInt?  @map("db_bytes")
  documentsBytes BigInt?  @map("documents_bytes")
  documentFiles  Int?     @map("document_files")
  tableCount     Int?     @map("table_count")
  rowTotal       BigInt?  @map("row_total")
  manifestSha256 String?  @map("manifest_sha256")
  /// Ringkas (maks. 500 karakter), tanpa rahasia koneksi.
  error          String?
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, backupKey])
  @@index([tenantId, finishedAt])
  @@map("backup_runs")
}

/// Fase 10 · Hasil uji restore di kontainer bersih (ADR-0071): RTO terukur + hasil tiap langkah. Tenant PLATFORM,
/// append-only, ditulis lewat `app_record_restore_test()`.
model RestoreTest {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  /// Kosong bila tidak ada backup lengkap yang bisa dipulihkan (uji tetap dicatat sebagai gagal).
  backupKey  String?  @map("backup_key")
  /// Lokasi asal backup yang dipulihkan: local | cloud | offsite
  source     String
  /// success | failed
  status     String
  startedAt  DateTime @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime @map("finished_at") @db.Timestamptz(3)
  rtoSeconds Int      @map("rto_seconds")
  /// Hasil per langkah `{ <langkah>: { ok, ms, detail? } }`, tanpa data pasien.
  checks     Json
  error      String?
  recordedAt DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, finishedAt])
  @@map("restore_tests")
}
