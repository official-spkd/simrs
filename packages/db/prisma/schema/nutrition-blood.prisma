// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// Fase 4 · S07 Gizi, S08 Bank darah (rencana fase 4 §4.0b, keputusan no. 1 dan 22). Tanpa layar: API + cetak HTML.
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

/// S07 · Order diet per kunjungan. Hanya status/akhir yang diubah (order baru = baris baru).
model DietOrder {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  encounterId String    @map("encounter_id") @db.Uuid
  patientId   String    @map("patient_id") @db.Uuid
  dietTypeId  String    @map("diet_type_id") @db.Uuid
  /// biasa | lunak | saring | cair | sonde
  texture     String
  notes       String?
  startsOn    DateTime  @map("starts_on") @db.Date
  /// aktif | selesai
  status      String    @default("aktif")
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(3)
  orderedBy   String    @map("ordered_by") @db.Uuid
  orderedAt   DateTime  @default(now()) @map("ordered_at") @db.Timestamptz(3)
  /// Verifikasi ahli gizi (migrasi 20261008800000): makanan baru boleh diantar setelah terverifikasi.
  verifiedBy  String?   @map("verified_by") @db.Uuid
  verifiedAt  DateTime? @map("verified_at") @db.Timestamptz(3)

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  verifier  User?         @relation("DietOrderVerifier", fields: [tenantId, verifiedBy], references: [tenantId, id])
  encounter Encounter     @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  patient   Patient       @relation(fields: [tenantId, patientId], references: [tenantId, id])
  dietType  DietType      @relation(fields: [tenantId, dietTypeId], references: [tenantId, id])
  orderer   User          @relation("DietOrderer", fields: [tenantId, orderedBy], references: [tenantId, id])
  meals     MealService[]

  @@unique([tenantId, id])
  @@index([tenantId, encounterId])
  @@map("diet_orders")
}

/// S07 · Layanan makan per jam makan + sisa makanan (append-only).
model MealService {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  dietOrderId String   @map("diet_order_id") @db.Uuid
  /// pagi | selingan_pagi | siang | selingan_sore | malam
  meal        String
  servedAt    DateTime @map("served_at") @db.Timestamptz(3)
  /// habis | sisa_seperempat | sisa_setengah | utuh (null = belum dinilai)
  leftover    String?
  recordedBy  String   @map("recorded_by") @db.Uuid
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  dietOrder DietOrder @relation(fields: [tenantId, dietOrderId], references: [tenantId, id])
  recorder  User      @relation("MealServiceRecorder", fields: [tenantId, recordedBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, dietOrderId, servedAt])
  @@map("meal_services")
}

/// S08 · Kantong darah: golongan ABO/Rh, ED, status (hanya status diubah).
model BloodUnit {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  bagNo       String   @map("bag_no")
  componentId String   @map("component_id") @db.Uuid
  /// A | B | AB | O
  abo         String
  /// pos | neg
  rh          String
  collectedAt DateTime @map("collected_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  /// tersedia | dicadangkan | dikeluarkan | kedaluwarsa | dimusnahkan
  status      String   @default("tersedia")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy   String?  @map("created_by") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  component    BloodComponent     @relation(fields: [tenantId, componentId], references: [tenantId, id])
  crossmatches Crossmatch[]
  issue        BloodIssue?
  issueChecks  BloodIssueCheck[]
  disposal     BloodUnitDisposal?

  @@unique([tenantId, id])
  @@unique([tenantId, bagNo])
  @@index([tenantId, componentId, abo, rh, status])
  @@map("blood_units")
}

/// S08 · Permintaan darah (nomor `BD-YYMM-NNNN`). Hanya status diubah.
model BloodRequest {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  requestNo    String    @map("request_no")
  encounterId  String    @map("encounter_id") @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  componentId  String    @map("component_id") @db.Uuid
  units        Int
  /// rutin | cito | darurat
  urgency      String
  indication   String
  patientAbo   String?   @map("patient_abo")
  patientRh    String?   @map("patient_rh")
  /// diminta | diproses | selesai | batal
  status       String    @default("diminta")
  requestedBy  String    @map("requested_by") @db.Uuid
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Pembatalan beralasan (migrasi 20261008800000): kantong yang belum keluar dilepas.
  cancelReason String?   @map("cancel_reason")
  cancelledBy  String?   @map("cancelled_by") @db.Uuid
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)

  tenant       Tenant            @relation(fields: [tenantId], references: [id])
  canceller    User?             @relation("BloodRequestCanceller", fields: [tenantId, cancelledBy], references: [tenantId, id])
  encounter    Encounter         @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  patient      Patient           @relation(fields: [tenantId, patientId], references: [tenantId, id])
  component    BloodComponent    @relation(fields: [tenantId, componentId], references: [tenantId, id])
  requester    User              @relation("BloodRequester", fields: [tenantId, requestedBy], references: [tenantId, id])
  crossmatches Crossmatch[]
  issues       BloodIssue[]
  issueChecks  BloodIssueCheck[]

  @@unique([tenantId, id])
  @@unique([tenantId, requestNo])
  @@index([tenantId, encounterId])
  @@map("blood_requests")
}

/// S08 · Uji silang (append-only): cocok | tidak_cocok.
model Crossmatch {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  bloodRequestId String   @map("blood_request_id") @db.Uuid
  bloodUnitId    String   @map("blood_unit_id") @db.Uuid
  result         String
  method         String
  testedBy       String   @map("tested_by") @db.Uuid
  testedAt       DateTime @default(now()) @map("tested_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  bloodRequest BloodRequest @relation(fields: [tenantId, bloodRequestId], references: [tenantId, id])
  bloodUnit    BloodUnit    @relation(fields: [tenantId, bloodUnitId], references: [tenantId, id])
  tester       User         @relation("CrossmatchTester", fields: [tenantId, testedBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, bloodRequestId, bloodUnitId])
  @@map("crossmatches")
}

/// S08 · Pengeluaran kantong (append-only, sekali per kantong). Trigger: ABO/Rh kompatibel, crossmatch cocok, belum
/// ED; darurat tanpa crossmatch hanya golongan O dengan alasan dokter (keputusan no. 22).
model BloodIssue {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  bloodRequestId  String   @map("blood_request_id") @db.Uuid
  bloodUnitId     String   @map("blood_unit_id") @db.Uuid
  encounterId     String   @map("encounter_id") @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  emergencyReason String?  @map("emergency_reason")
  /// Petugas KEDUA (sesinya sendiri) yang mengeluarkan kantong; pemeriksa pertama ada di `issueCheck`.
  issuedBy        String   @map("issued_by") @db.Uuid
  issuedAt        DateTime @default(now()) @map("issued_at") @db.Timestamptz(3)
  /// Cek ganda pertama (migrasi 20261008500000). Wajib untuk baris baru (CHECK NOT VALID + trigger).
  issueCheckId    String?  @map("issue_check_id") @db.Uuid

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  bloodRequest BloodRequest          @relation(fields: [tenantId, bloodRequestId], references: [tenantId, id])
  bloodUnit    BloodUnit             @relation(fields: [tenantId, bloodUnitId], references: [tenantId, id])
  encounter    Encounter             @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  patient      Patient               @relation(fields: [tenantId, patientId], references: [tenantId, id])
  issuer       User                  @relation("BloodIssuer", fields: [tenantId, issuedBy], references: [tenantId, id])
  issueCheck   BloodIssueCheck?      @relation(fields: [tenantId, issueCheckId], references: [tenantId, id])
  reactions    TransfusionReaction[]
  transfusion  Transfusion?

  @@unique([tenantId, id])
  @@unique([tenantId, bloodUnitId])
  @@unique([tenantId, issueCheckId])
  @@index([tenantId, bloodRequestId])
  @@map("blood_issues")
}

/// S08 · Reaksi transfusi (append-only).
model TransfusionReaction {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  bloodIssueId String   @map("blood_issue_id") @db.Uuid
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(3)
  /// ringan | sedang | berat
  severity     String
  description  String
  reportedBy   String   @map("reported_by") @db.Uuid
  reportedAt   DateTime @default(now()) @map("reported_at") @db.Timestamptz(3)

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  bloodIssue      BloodIssue       @relation(fields: [tenantId, bloodIssueId], references: [tenantId, id])
  reporter        User             @relation("TransfusionReactionReporter", fields: [tenantId, reportedBy], references: [tenantId, id])
  criticalResults CriticalResult[]

  @@unique([tenantId, id])
  @@index([tenantId, bloodIssueId])
  @@map("transfusion_reactions")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// Fase 4 · 4.9 · S08 gerbang keselamatan bank darah (migrasi 20261008500000_blood_bank_safety, ADR-0105).
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

/// S08 · Cek ganda PERTAMA sebelum kantong keluar (append-only): petugas bank darah mencentang lima butir. Kantong
/// baru keluar bila petugas KEDUA dari sesinya sendiri mengeluarkannya (`blood_issues.issue_check_id`, trigger).
model BloodIssueCheck {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  bloodRequestId  String   @map("blood_request_id") @db.Uuid
  bloodUnitId     String   @map("blood_unit_id") @db.Uuid
  /// Lima butir (`BLOOD_ISSUE_CHECK_ITEMS`) semuanya `true` (CHECK).
  checklist       Json
  /// Jalur darurat tanpa crossmatch (keputusan fase 4 no. 22): alasan dokter >= 10 karakter.
  emergencyReason String?  @map("emergency_reason")
  checkedBy       String   @map("checked_by") @db.Uuid
  checkedAt       DateTime @default(now()) @map("checked_at") @db.Timestamptz(3)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  bloodRequest BloodRequest @relation(fields: [tenantId, bloodRequestId], references: [tenantId, id])
  bloodUnit    BloodUnit    @relation(fields: [tenantId, bloodUnitId], references: [tenantId, id])
  checker      User         @relation("BloodIssueChecker", fields: [tenantId, checkedBy], references: [tenantId, id])
  issue        BloodIssue?

  @@unique([tenantId, id])
  @@index([tenantId, bloodRequestId])
  @@map("blood_issue_checks")
}

/// S08 · Transfusi di samping pasien: pemasang memindai gelang (pindaian gelang fase 3) + nomor kantong, lalu
/// petugas KEDUA dari sesinya sendiri memindai ulang gelang + kantong sebelum transfusi berjalan. Hanya kolom
/// verifikasi/penutupan yang diubah (trigger menjaga transisi).
model Transfusion {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  bloodIssueId String    @map("blood_issue_id") @db.Uuid
  encounterId  String    @map("encounter_id") @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  startScanId  String    @map("start_scan_id") @db.Uuid
  startBagNo   String    @map("start_bag_no")
  startedBy    String    @map("started_by") @db.Uuid
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  verifyScanId String?   @map("verify_scan_id") @db.Uuid
  verifyBagNo  String?   @map("verify_bag_no")
  verifiedBy   String?   @map("verified_by") @db.Uuid
  verifiedAt   DateTime? @map("verified_at") @db.Timestamptz(3)
  /// menunggu_verifikasi | berjalan | selesai | dihentikan
  status       String    @default("menunggu_verifikasi")
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(3)
  endedBy      String?   @map("ended_by") @db.Uuid
  stopReason   String?   @map("stop_reason")

  tenant     Tenant             @relation(fields: [tenantId], references: [id])
  bloodIssue BloodIssue         @relation(fields: [tenantId, bloodIssueId], references: [tenantId, id])
  encounter  Encounter          @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  patient    Patient            @relation(fields: [tenantId, patientId], references: [tenantId, id])
  startScan  WristbandScan      @relation("TransfusionStartScan", fields: [tenantId, startScanId], references: [tenantId, id])
  verifyScan WristbandScan?     @relation("TransfusionVerifyScan", fields: [tenantId, verifyScanId], references: [tenantId, id])
  starter    User               @relation("TransfusionStarter", fields: [tenantId, startedBy], references: [tenantId, id])
  verifier   User?              @relation("TransfusionVerifier", fields: [tenantId, verifiedBy], references: [tenantId, id])
  ender      User?              @relation("TransfusionEnder", fields: [tenantId, endedBy], references: [tenantId, id])
  vitals     TransfusionVital[]

  @@unique([tenantId, id])
  @@unique([tenantId, bloodIssueId])
  @@index([tenantId, encounterId])
  @@map("transfusions")
}

/// S08 · Tanda vital selama transfusi (append-only, waktu server): awal, 15 menit, 1 jam, selesai.
model TransfusionVital {
  id            String   @id @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  transfusionId String   @map("transfusion_id") @db.Uuid
  /// awal | 15_menit | 1_jam | selesai | lain
  label         String
  tempC         Decimal  @map("temp_c") @db.Decimal(4, 1)
  systolic      Int
  diastolic     Int
  pulse         Int
  signs         String[]
  recordedBy    String   @map("recorded_by") @db.Uuid
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  transfusion Transfusion @relation(fields: [tenantId, transfusionId], references: [tenantId, id])
  recorder    User        @relation("TransfusionVitalRecorder", fields: [tenantId, recordedBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, transfusionId, recordedAt])
  @@map("transfusion_vitals")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// Fase 4 · 4.9b · S07 puasa + skrining MST, S08 pemusnahan kantong (migrasi 20261008800000, ADR-0106).
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

/// S08 · Pemusnahan kantong (dua petugas, sesi masing-masing): petugas pertama mengajukan beralasan, petugas KEDUA
/// mengonfirmasi; kantong lalu `dimusnahkan`. Satu per kantong; hanya kolom konfirmasi yang diubah.
model BloodUnitDisposal {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  bloodUnitId String    @map("blood_unit_id") @db.Uuid
  /// kedaluwarsa | rusak
  category    String
  reason      String
  requestedBy String    @map("requested_by") @db.Uuid
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  confirmedBy String?   @map("confirmed_by") @db.Uuid
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  bloodUnit BloodUnit @relation(fields: [tenantId, bloodUnitId], references: [tenantId, id])
  requester User      @relation("BloodDisposalRequester", fields: [tenantId, requestedBy], references: [tenantId, id])
  confirmer User?     @relation("BloodDisposalConfirmer", fields: [tenantId, confirmedBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, bloodUnitId])
  @@map("blood_unit_disposals")
}

/// S07 · Puasa (NPO) per kunjungan: selama aktif makanan tidak diantar (trigger `meal_services`). Dicabut sekali.
model DietNpoOrder {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  encounterId  String    @map("encounter_id") @db.Uuid
  patientId    String    @map("patient_id") @db.Uuid
  reason       String
  /// Rencana selesai (informasi untuk dapur); puasa tetap aktif sampai dicabut.
  plannedUntil DateTime? @map("planned_until") @db.Timestamptz(3)
  orderedBy    String    @map("ordered_by") @db.Uuid
  orderedAt    DateTime  @default(now()) @map("ordered_at") @db.Timestamptz(3)
  liftedBy     String?   @map("lifted_by") @db.Uuid
  liftedAt     DateTime? @map("lifted_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  encounter Encounter @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  patient   Patient   @relation(fields: [tenantId, patientId], references: [tenantId, id])
  orderer   User      @relation("DietNpoOrderer", fields: [tenantId, orderedBy], references: [tenantId, id])
  lifter    User?     @relation("DietNpoLifter", fields: [tenantId, liftedBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, encounterId])
  @@map("diet_npo_orders")
}

/// S07 · Skrining gizi MST (append-only, waktu server). Skor = penurunan BB (0–4) + nafsu makan turun (1); ≥ 2 berisiko.
model NutritionScreening {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  encounterId  String   @map("encounter_id") @db.Uuid
  patientId    String   @map("patient_id") @db.Uuid
  /// tidak | tidak_yakin | 1_5 | 6_10 | 11_15 | lebih_15
  weightLoss   String   @map("weight_loss")
  poorAppetite Boolean  @map("poor_appetite")
  score        Int
  atRisk       Boolean  @map("at_risk")
  screenedBy   String   @map("screened_by") @db.Uuid
  screenedAt   DateTime @default(now()) @map("screened_at") @db.Timestamptz(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  encounter Encounter @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  patient   Patient   @relation(fields: [tenantId, patientId], references: [tenantId, id])
  screener  User      @relation("NutritionScreener", fields: [tenantId, screenedBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, encounterId, screenedAt])
  @@map("nutrition_screenings")
}
