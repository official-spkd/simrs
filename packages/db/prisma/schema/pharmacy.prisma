// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════
// Fase 4 · S04 Farmasi klinis, S05 Dispensing + stok depo (rencana fase 4 §4.0b, keputusan no. 9–12).
// Stok: ledger `stock_movements` append-only; saldo `stock_balances` HANYA diubah trigger (CHECK ≥ 0); batch beku.
// ═══════════════════════════════════════════════════════════════════════════════════════════════════════════

/// S05 · Batch obat: nomor batch, ED, harga pokok per satuan (bigint rupiah), pemasok. Beku setelah dibuat.
model StockBatch {
  id         String   @id @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  drugId     String   @map("drug_id") @db.Uuid
  batchNo    String   @map("batch_no")
  expiryDate DateTime @map("expiry_date") @db.Date
  unitCost   BigInt   @map("unit_cost")
  supplierId String?  @map("supplier_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy  String?  @map("created_by") @db.Uuid

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  drug          Drug            @relation(fields: [tenantId, drugId], references: [tenantId, id])
  supplier      Supplier?       @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  balances      StockBalance[]
  movements     StockMovement[]
  dispenseItems DispenseItem[]

  @@unique([tenantId, id])
  @@unique([tenantId, drugId, batchNo])
  @@index([tenantId, drugId, expiryDate])
  @@map("stock_batches")
}

/// S05 · Saldo per lokasi × batch. Diisi/diubah HANYA trigger ledger (`app_stock_apply_movement`); CHECK ≥ 0.
model StockBalance {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  stockLocationId String   @map("stock_location_id") @db.Uuid
  stockBatchId    String   @map("stock_batch_id") @db.Uuid
  drugId          String   @map("drug_id") @db.Uuid
  quantity        Int      @default(0)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  stockLocation StockLocation @relation(fields: [tenantId, stockLocationId], references: [tenantId, id])
  stockBatch    StockBatch    @relation(fields: [tenantId, stockBatchId], references: [tenantId, id])
  drug          Drug          @relation(fields: [tenantId, drugId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, stockLocationId, stockBatchId])
  @@index([tenantId, stockLocationId, drugId])
  @@map("stock_balances")
}

/// S05 · Ledger stok (append-only): jenis, qty bertanda (masuk +, keluar −), rujukan, alasan. Trigger memperbarui
/// saldo pada transaksi yang sama dan menolak pengeluaran batch kedaluwarsa ke pasien (`dispense`, `usage`).
model StockMovement {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  stockLocationId String   @map("stock_location_id") @db.Uuid
  stockBatchId    String   @map("stock_batch_id") @db.Uuid
  /// receipt | transfer_out | transfer_in | dispense | return | adjustment | usage | write_off
  kind            String
  quantity        Int
  /// Tabel + baris rujukan (`stock_receipts`, `dispenses`, `surgery_cases`, …).
  refType         String   @map("ref_type")
  refId           String   @map("ref_id") @db.Uuid
  reason          String?
  /// Harga pokok per satuan baris penerimaan (`receipt`, rupiah bigint); null untuk jenis lain. Dibaca HPP/jurnal fase 5.
  unitCost        BigInt?  @map("unit_cost")
  encounterId     String?  @map("encounter_id") @db.Uuid
  patientId       String?  @map("patient_id") @db.Uuid
  createdBy       String   @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant         Tenant              @relation(fields: [tenantId], references: [id])
  stockLocation  StockLocation       @relation(fields: [tenantId, stockLocationId], references: [tenantId, id])
  stockBatch     StockBatch          @relation(fields: [tenantId, stockBatchId], references: [tenantId, id])
  encounter      Encounter?          @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  patient        Patient?            @relation(fields: [tenantId, patientId], references: [tenantId, id])
  creator        User                @relation("StockMovementCreator", fields: [tenantId, createdBy], references: [tenantId, id])
  dispenseItem   DispenseItem?
  dispenseReturn DispenseReturn[]
  supplyUsage    SurgerySupplyUsage?

  @@unique([tenantId, id])
  @@index([tenantId, stockLocationId, stockBatchId, createdAt])
  @@index([tenantId, refType, refId])
  @@map("stock_movements")
}

/// S05 · Penerimaan barang tanpa PO (keputusan no. 10). Append-only; item = movement `receipt`.
model StockReceipt {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  receiptNo       String   @map("receipt_no")
  stockLocationId String   @map("stock_location_id") @db.Uuid
  supplierId      String   @map("supplier_id") @db.Uuid
  invoiceNo       String   @map("invoice_no")
  receivedBy      String   @map("received_by") @db.Uuid
  receivedAt      DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  stockLocation StockLocation @relation(fields: [tenantId, stockLocationId], references: [tenantId, id])
  supplier      Supplier      @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  receiver      User          @relation("StockReceiptReceiver", fields: [tenantId, receivedBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, receiptNo])
  /// Satu faktur pemasok diterima sekali (4.6a-2).
  @@unique([tenantId, supplierId, invoiceNo])
  @@map("stock_receipts")
}

/// S05 · Mutasi dua langkah: `dikirim` (transfer_out asal) → `diterima` (transfer_in tujuan). Hanya status diubah.
model StockTransfer {
  id                  String    @id @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  transferNo          String    @map("transfer_no")
  fromStockLocationId String    @map("from_stock_location_id") @db.Uuid
  toStockLocationId   String    @map("to_stock_location_id") @db.Uuid
  /// dikirim | diterima | dibatalkan
  status              String    @default("dikirim")
  /// Item `[{stockBatchId, quantity}]` beku saat dikirim.
  items               Json
  sentBy              String    @map("sent_by") @db.Uuid
  sentAt              DateTime  @default(now()) @map("sent_at") @db.Timestamptz(3)
  receivedBy          String?   @map("received_by") @db.Uuid
  receivedAt          DateTime? @map("received_at") @db.Timestamptz(3)
  /// Pembatalan mutasi yang tersangkut `dikirim` (4.6a-2): stok kembali ke depo asal lewat ledger pembalik.
  cancelledBy         String?   @map("cancelled_by") @db.Uuid
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason        String?   @map("cancel_reason")

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  from      StockLocation @relation("StockTransferFrom", fields: [tenantId, fromStockLocationId], references: [tenantId, id])
  to        StockLocation @relation("StockTransferTo", fields: [tenantId, toStockLocationId], references: [tenantId, id])
  sender    User          @relation("StockTransferSender", fields: [tenantId, sentBy], references: [tenantId, id])
  receiver  User?         @relation("StockTransferReceiver", fields: [tenantId, receivedBy], references: [tenantId, id])
  canceller User?         @relation("StockTransferCanceller", fields: [tenantId, cancelledBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, transferNo])
  @@map("stock_transfers")
}

/// S05 · Penyesuaian stok beralasan (append-only; item = movement `adjustment`).
model StockAdjustment {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  stockLocationId String   @map("stock_location_id") @db.Uuid
  reason          String
  adjustedBy      String   @map("adjusted_by") @db.Uuid
  adjustedAt      DateTime @default(now()) @map("adjusted_at") @db.Timestamptz(3)

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  stockLocation StockLocation @relation(fields: [tenantId, stockLocationId], references: [tenantId, id])
  adjuster      User          @relation("StockAdjustmentAdjuster", fields: [tenantId, adjustedBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@map("stock_adjustments")
}

/// S04 · Resep yang dilayani farmasi: satu per kiriman CPOE (`order_groups`), nomor R, depo, status (+ riwayat).
model PharmacyPrescription {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  prescriptionNo  String   @map("prescription_no")
  orderGroupId    String   @map("order_group_id") @db.Uuid
  encounterId     String   @map("encounter_id") @db.Uuid
  patientId       String   @map("patient_id") @db.Uuid
  stockLocationId String   @map("stock_location_id") @db.Uuid
  /// rawat_jalan | rawat_inap | igd | ok
  setting         String
  /// telaah | ditahan | penyiapan | serah | selesai | batal
  status          String   @default("telaah")
  acceptedBy      String   @map("accepted_by") @db.Uuid
  acceptedAt      DateTime @default(now()) @map("accepted_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant        Tenant                              @relation(fields: [tenantId], references: [id])
  orderGroup    OrderGroup                          @relation(fields: [tenantId, orderGroupId], references: [tenantId, id])
  encounter     Encounter                           @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  patient       Patient                             @relation(fields: [tenantId, patientId], references: [tenantId, id])
  stockLocation StockLocation                       @relation(fields: [tenantId, stockLocationId], references: [tenantId, id])
  acceptor      User                                @relation("PrescriptionAcceptor", fields: [tenantId, acceptedBy], references: [tenantId, id])
  statusHistory PharmacyPrescriptionStatusHistory[]
  reviews       PrescriptionReview[]
  interventions PharmacistIntervention[]
  dispenses     Dispense[]

  @@unique([tenantId, id])
  @@unique([tenantId, prescriptionNo])
  @@unique([tenantId, orderGroupId])
  @@index([tenantId, stockLocationId, status])
  @@map("pharmacy_prescriptions")
}

/// S04 · Riwayat status resep (append-only).
model PharmacyPrescriptionStatusHistory {
  id                     String   @id @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  pharmacyPrescriptionId String   @map("pharmacy_prescription_id") @db.Uuid
  fromStatus             String?  @map("from_status")
  toStatus               String   @map("to_status")
  changedBy              String?  @map("changed_by") @db.Uuid
  changedAt              DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)
  reason                 String?

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  prescription PharmacyPrescription @relation(fields: [tenantId, pharmacyPrescriptionId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, pharmacyPrescriptionId, changedAt])
  @@map("pharmacy_prescription_status_history")
}

/// S04 · Telaah resep tiga aspek (append-only): setujui | tahan | sebagian.
model PrescriptionReview {
  id                     String   @id @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  pharmacyPrescriptionId String   @map("pharmacy_prescription_id") @db.Uuid
  administratif          Boolean
  farmasetik             Boolean
  klinis                 Boolean
  decision               String
  reason                 String?
  /// Item yang disetujui untuk keputusan `sebagian`.
  medicationRequestIds   String[] @map("medication_request_ids") @db.Uuid
  reviewedBy             String   @map("reviewed_by") @db.Uuid
  reviewedAt             DateTime @default(now()) @map("reviewed_at") @db.Timestamptz(3)

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  prescription PharmacyPrescription @relation(fields: [tenantId, pharmacyPrescriptionId], references: [tenantId, id])
  reviewer     User                 @relation("PrescriptionReviewer", fields: [tenantId, reviewedBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, pharmacyPrescriptionId])
  @@map("prescription_reviews")
}

/// S04 · Intervensi apoteker ke dokter penulis (append-only). Apoteker tidak mengubah resep: dokter di CPOE.
model PharmacistIntervention {
  id                     String   @id @db.Uuid
  tenantId               String   @map("tenant_id") @db.Uuid
  pharmacyPrescriptionId String   @map("pharmacy_prescription_id") @db.Uuid
  /// ganti_obat | ubah_dosis | hentikan | tambah | lainnya
  kind                   String
  medicationRequestIds   String[] @map("medication_request_ids") @db.Uuid
  recommendation         String
  /// Dokter penulis yang diberi notifikasi.
  prescriberUserId       String   @map("prescriber_user_id") @db.Uuid
  createdBy              String   @map("created_by") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant       Tenant                          @relation(fields: [tenantId], references: [id])
  prescription PharmacyPrescription            @relation(fields: [tenantId, pharmacyPrescriptionId], references: [tenantId, id])
  prescriber   User                            @relation("InterventionPrescriber", fields: [tenantId, prescriberUserId], references: [tenantId, id])
  creator      User                            @relation("InterventionCreator", fields: [tenantId, createdBy], references: [tenantId, id])
  response     PharmacistInterventionResponse?

  @@unique([tenantId, id])
  @@index([tenantId, pharmacyPrescriptionId])
  @@map("pharmacist_interventions")
}

/// S04 · Jawaban dokter atas intervensi (append-only): diterima | ditolak | diubah (versi resep baru di CPOE).
model PharmacistInterventionResponse {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  interventionId String   @map("intervention_id") @db.Uuid
  response       String
  note           String?
  respondedBy    String   @map("responded_by") @db.Uuid
  respondedAt    DateTime @default(now()) @map("responded_at") @db.Timestamptz(3)

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  intervention PharmacistIntervention @relation(fields: [tenantId, interventionId], references: [tenantId, id])
  responder    User                   @relation("InterventionResponder", fields: [tenantId, respondedBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, interventionId])
  @@map("pharmacist_intervention_responses")
}

/// S05 · Penyiapan + penyerahan obat. CHECK `double_checked_by <> prepared_by`; hanya kolom cek ganda/serah diubah.
model Dispense {
  id                     String    @id @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  pharmacyPrescriptionId String    @map("pharmacy_prescription_id") @db.Uuid
  encounterId            String    @map("encounter_id") @db.Uuid
  patientId              String    @map("patient_id") @db.Uuid
  stockLocationId        String    @map("stock_location_id") @db.Uuid
  preparedBy             String    @map("prepared_by") @db.Uuid
  preparedAt             DateTime  @default(now()) @map("prepared_at") @db.Timestamptz(3)
  hasHighAlert           Boolean   @default(false) @map("has_high_alert")
  doubleCheckedBy        String?   @map("double_checked_by") @db.Uuid
  doubleCheckedAt        DateTime? @map("double_checked_at") @db.Timestamptz(3)
  handedOverBy           String?   @map("handed_over_by") @db.Uuid
  handedOverAt           DateTime? @map("handed_over_at") @db.Timestamptz(3)
  /// pasien | keluarga | perawat
  receiverKind           String?   @map("receiver_kind")
  receiverName           String?   @map("receiver_name")
  counselingGiven        Boolean   @default(false) @map("counseling_given")

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  prescription  PharmacyPrescription @relation(fields: [tenantId, pharmacyPrescriptionId], references: [tenantId, id])
  encounter     Encounter            @relation(fields: [tenantId, encounterId], references: [tenantId, id])
  patient       Patient              @relation(fields: [tenantId, patientId], references: [tenantId, id])
  preparer      User                 @relation("DispensePreparer", fields: [tenantId, preparedBy], references: [tenantId, id])
  doubleChecker User?                @relation("DispenseDoubleChecker", fields: [tenantId, doubleCheckedBy], references: [tenantId, id])
  handedOverByU User?                @relation("DispenseHandover", fields: [tenantId, handedOverBy], references: [tenantId, id])
  items         DispenseItem[]

  @@unique([tenantId, id])
  @@index([tenantId, pharmacyPrescriptionId])
  @@map("dispenses")
}

/// S05 · Item penyerahan (append-only): batch, qty, barcode label dosis (dipindai eMAR, F3-5), alasan non-FEFO.
model DispenseItem {
  id                  String  @id @db.Uuid
  tenantId            String  @map("tenant_id") @db.Uuid
  dispenseId          String  @map("dispense_id") @db.Uuid
  medicationRequestId String  @map("medication_request_id") @db.Uuid
  stockBatchId        String  @map("stock_batch_id") @db.Uuid
  quantity            Int
  labelBarcode        String  @map("label_barcode")
  fefoOverrideReason  String? @map("fefo_override_reason")
  stockMovementId     String  @map("stock_movement_id") @db.Uuid

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  dispense          Dispense          @relation(fields: [tenantId, dispenseId], references: [tenantId, id])
  medicationRequest MedicationRequest @relation(fields: [tenantId, medicationRequestId], references: [tenantId, id])
  stockBatch        StockBatch        @relation(fields: [tenantId, stockBatchId], references: [tenantId, id])
  stockMovement     StockMovement     @relation(fields: [tenantId, stockMovementId], references: [tenantId, id])
  returns           DispenseReturn[]

  @@unique([tenantId, id])
  @@unique([tenantId, labelBarcode])
  @@unique([tenantId, stockMovementId])
  @@index([tenantId, dispenseId])
  @@map("dispense_items")
}

/// S05 · Retur obat (append-only): layak → movement `return` ke depo; tidak layak → `write_off` (tanpa saldo masuk).
model DispenseReturn {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  dispenseItemId  String   @map("dispense_item_id") @db.Uuid
  quantity        Int
  /// layak | tidak_layak
  condition       String
  reason          String
  stockMovementId String?  @map("stock_movement_id") @db.Uuid
  returnedBy      String   @map("returned_by") @db.Uuid
  returnedAt      DateTime @default(now()) @map("returned_at") @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  dispenseItem  DispenseItem   @relation(fields: [tenantId, dispenseItemId], references: [tenantId, id])
  stockMovement StockMovement? @relation(fields: [tenantId, stockMovementId], references: [tenantId, id])
  returner      User           @relation("DispenseReturner", fields: [tenantId, returnedBy], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, dispenseItemId])
  @@map("dispense_returns")
}
